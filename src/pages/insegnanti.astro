---
import Base from '../layouts/Base.astro';
import Libretto from '../components/Libretto.astro';
import Nome from '../components/Nome.astro';
import { sito } from '../data/sito';
---
<Base title="Insegnanti di musica" current="insegnanti/" description={`I musicisti che insegnano canto, chitarra, basso, batteria, pianoforte e coro a ${sito.nome}, scuola di musica pop e rock di ${sito.citta}.`}>
  <div class="wrap page-head">
    <h1 class="display display-xl">Insegnanti<span class="dot">.</span></h1>
    <p class="lead intro">Musicisti veri, prima che insegnanti. Sfoglia il booklet degli insegnanti di <Nome />!</p>
  </div>

  <div class="wrap lettore-pagina">
    <Libretto aggiornaIndirizzo />
  </div>

  <section class="wrap cta">
    <h2 class="display display-m">Vuoi conoscerli<br /><span class="dot">di persona?</span></h2>
    <a href={`mailto:${sito.email}?subject=Lezione di prova`} class="btn btn-cream">Prenota una lezione di prova</a>
  </section>
</Base>

<style>
  .lettore-pagina { padding-bottom: 40px; }
  .cta { padding-top: var(--spazio-sezione); padding-bottom: var(--spazio-sezione); text-align: center; display: flex; flex-direction: column; align-items: center; gap: 32px; }
</style>
