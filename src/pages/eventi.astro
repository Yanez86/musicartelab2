---
import Base from '../layouts/Base.astro';
import { eventiDivisi, inArrivo, linkEvento } from '../lib/eventi';
import { u, giorno, meseBreve, dataBreve } from '../lib/url';
import { sito } from '../data/sito';
import Testo from '../components/Testo.astro';
import Nome from '../components/Nome.astro';
import EventoTop from '../components/EventoTop.astro';

const { tutti, recenti, archivio, futuri, principale: top, principaleFuturo: topFuturo } = await eventiDivisi();
const gruppi = [
  {
    id: 'futuri',
    titolo: 'Eventi futuri',
    lista: futuri.filter((e) => e.id !== top?.id),
    vuoto: 'Nessun altro evento di questo tipo in programma, per ora.',
  },
  {
    id: 'passati',
    titolo: 'Eventi passati',
    lista: recenti.filter((e) => !inArrivo(e) && e.id !== top?.id),
    vuoto: 'Nessun evento di questo tipo negli ultimi dodici mesi.',
  },
];
const tipi = ['Tutti', ...new Set(tutti.map((e) => e.data.tipo))];
const img = (f?: string) => (f ? u(`img/eventi/${f}`) : u('img/concerto.jpg'));
---
<Base title={`Eventi e concerti a ${sito.citta}`} current="eventi/" description={`Concerti, jam session, masterclass e feste di ${sito.nome} a ${sito.citta}: i prossimi eventi, le prenotazioni e l’archivio.`}>
  <div class="wrap page-head">
    <h1 class="display display-xl">Eventi<span class="dot">.</span></h1>
    <p class="lead intro">Palchi, jam, masterclass e feste: la musica di <Nome /> si vive dal vivo.</p>
  </div>

  {top && (
    <section class="wrap" style="margin-bottom: 72px;" aria-label={topFuturo ? 'Prossimo evento' : 'Il più recente'}>
      <EventoTop evento={top} futuro={topFuturo} />
    </section>
  )}

  <div class="wrap filtri-bar">
    <span class="filtri-label">Filtra per tipo</span>
    <div class="filters" role="group" aria-label="Filtra gli eventi per tipo" data-filtri="eventi">
      {tipi.map((t, i) => <button type="button" class="filter" data-filtro={t} aria-pressed={i === 0 ? 'true' : 'false'}>{t}</button>)}
    </div>
  </div>

  {gruppi.map((g) => (
    <section class="wrap gruppo" aria-labelledby={`titolo-${g.id}`}>
      <h2 id={`titolo-${g.id}`} class="display gruppo-titolo">{g.titolo}</h2>
      <p class="vuoto" data-vuoto={g.id} hidden={g.lista.length > 0 || g.id === 'futuri'}>{g.vuoto}</p>
      <div class="griglia" data-lista={g.id}>
        {g.lista.map((e) => (
          <article class="ev" id={e.id} data-tipo={e.data.tipo}>
            <div class="ev-img">
              <img src={img(e.data.locandina)} alt={`Locandina: ${e.data.titolo}`} loading="lazy" />
              <span class="ev-date"><b>{giorno(e.data.data)}</b><small>{meseBreve(e.data.data)}</small></span>
            </div>
            <div class="ev-txt">
              <span class="tag">{e.data.tipo}</span>
              <h3 class="display"><a href={linkEvento(e)} class="ev-link">{e.data.titolo}{e.data.sottotitolo && <> · <Testo t={e.data.sottotitolo} /></>}</a></h3>
              <span class="ev-quando">{e.data.quando}</span>
              <span class="ev-luogo"><Testo t={e.data.luogo} /></span>
              {e.data.info.length > 0 && <ul>{e.data.info.map((r) => <li><Testo t={r} /></li>)}</ul>}
              {g.id === 'futuri' && e.data.prenotazione && <a href={e.data.prenotazione} class="btn btn-red ev-btn" target="_blank" rel="noopener">{e.data.bottone}</a>}
            </div>
          </article>
        ))}
        {g.id === 'futuri' && (
          <a href={sito.instagram} rel="noopener" target="_blank" class="ev sorprese">
            <div class="sorprese-top" aria-hidden="true"><span>stay<br />tuned</span></div>
            <div class="ev-txt">
              <span class="tag">In arrivo</span>
              <h3 class="display">Altre sorprese</h3>
              <p>{sito.sorprese}</p>
              <span class="sorprese-cta">Seguici su Instagram →</span>
            </div>
          </a>
        )}
      </div>
    </section>
  ))}

  <section class="wrap archivio" aria-labelledby="archivio">
    <div class="arch-head">
      <h2 id="archivio" class="display">Archivio</h2>
      <span>Eventi di oltre un anno fa</span>
    </div>
    <p class="vuoto" data-vuoto="archivio" hidden={archivio.length > 0}>Nessun evento in archivio per questo filtro.</p>
    <div data-lista="archivio">
      {archivio.map((e) => (
        <div class="arch-row" data-tipo={e.data.tipo}>
          <img src={img(e.data.locandina)} alt="" loading="lazy" />
          <span class="arch-data">{dataBreve(e.data.data)}</span>
          <span class="arch-txt"><span class="tag">{e.data.tipo}</span><a href={linkEvento(e)} class="display ev-link">{e.data.titolo}</a></span>
          <span class="arch-luogo"><Testo t={e.data.luogo} /></span>
        </div>
      ))}
    </div>
  </section>

  <section class="cream news">
    <div class="wrap news-in">
      <h2 class="display display-m">Non perderti<br /><span class="rosso">il prossimo evento</span></h2>
      <div class="btn-row">
        <a href={sito.whatsappLink} class="btn btn-red">Scrivici su WhatsApp</a>
        <a href={`mailto:${sito.email}`} class="btn btn-line">{sito.email}</a>
      </div>
    </div>
  </section>
</Base>

<script>
  const gruppo = document.querySelector<HTMLElement>('[data-filtri="eventi"]');
  if (gruppo) {
    const bottoni = gruppo.querySelectorAll<HTMLButtonElement>('[data-filtro]');
    bottoni.forEach((b) =>
      b.addEventListener('click', () => {
        const t = b.dataset.filtro!;
        bottoni.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
        ['futuri', 'passati', 'archivio'].forEach((nome) => {
          const voci = document.querySelectorAll<HTMLElement>(`[data-lista="${nome}"] [data-tipo]`);
          let visibili = 0;
          voci.forEach((v) => {
            v.hidden = t !== 'Tutti' && v.dataset.tipo !== t;
            if (!v.hidden) visibili++;
          });
          const vuoto = document.querySelector<HTMLElement>(`[data-vuoto="${nome}"]`);
          if (vuoto) vuoto.hidden = visibili > 0;
        });
      }),
    );
  }
</script>

<style>
  .filtri-bar { display: flex; flex-wrap: wrap; align-items: center; gap: 12px 20px; padding-bottom: 48px; }
  .filtri-label { font-size: 0.8125rem; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: var(--muted); }
  .gruppo { padding-bottom: 90px; }
  .gruppo-titolo { font-size: 3rem; margin-bottom: 28px; }
  .arch-head h2 { font-size: 3rem; }
  .vuoto { margin: 0; padding-bottom: 12px; font-size: 1.0625rem; color: var(--muted); }
  .griglia { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(280px, 100%), 1fr)); gap: 24px; }
  .griglia:empty { display: none; }
  .ev { background: var(--card); border: 1px solid var(--line); border-radius: 22px; overflow: hidden; display: flex; flex-direction: column; transition: transform 0.3s, border-color 0.3s; scroll-margin-top: 24px; }
  .ev:hover, .ev:focus-within { transform: translateY(-8px); border-color: var(--red); }
  /* Il link del titolo copre tutta la scheda; il pulsante di prenotazione resta sopra */
  .ev, .arch-row { position: relative; }
  .ev-link { text-decoration: none; }
  .ev-link::after { content: ''; position: absolute; inset: 0; }
  .ev-link:focus-visible { outline: none; }
  .ev-link:focus-visible::after { outline: 3px solid var(--cream); outline-offset: -3px; border-radius: inherit; }
  .ev-img { position: relative; aspect-ratio: 4 / 5; overflow: hidden; background: var(--card-hover); }
  .ev-img img { width: 100%; height: 100%; object-fit: cover; object-position: center top; transition: transform 0.5s; }
  .ev:hover .ev-img img { transform: scale(1.04); }
  .ev-date { position: absolute; left: 14px; top: 14px; display: flex; flex-direction: column; align-items: center; background: var(--red); border-radius: 14px; padding: 10px 14px; box-shadow: 0 8px 20px rgba(0, 0, 0, 0.4); }
  .ev-date b { font-family: var(--display); font-weight: 400; font-size: 2.25rem; line-height: 1; }
  .ev-date small { font-size: 0.75rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em; color: var(--cream); }
  .ev-txt { padding: 22px; display: flex; flex-direction: column; gap: 10px; flex: 1; }
  .ev-btn { margin-top: auto; align-self: flex-start; min-height: 44px; padding: 11px 22px; position: relative; z-index: 1; }
  .ev-txt h3 { font-size: 1.875rem; line-height: 1.02; }
  .ev-quando { font-size: 0.875rem; color: var(--text-2); }
  .ev-luogo { font-size: 0.875rem; color: var(--muted); }
  .ev-txt ul { margin: 4px 0 0; padding-left: 18px; display: flex; flex-direction: column; gap: 6px; font-size: 0.875rem; line-height: 1.45; color: #d9cfc9; }
  .ev-txt li::marker { color: var(--red-light); }
  .sorprese { background: transparent; border: 2px dashed var(--cream); text-decoration: none; }
  .sorprese:hover { color: #fff; }
  .sorprese-top { aspect-ratio: 4 / 5; display: grid; place-items: center; background: repeating-linear-gradient(135deg, rgba(237, 227, 209, 0.06) 0 14px, transparent 14px 28px); }
  .sorprese-top span { font-family: var(--script); font-size: clamp(3.5rem, 7vw, 4.75rem); line-height: 0.95; text-align: center; color: var(--cream); transform: rotate(-8deg); }
  .sorprese:hover .sorprese-top span { color: var(--red-light); }
  .sorprese .ev-txt p { margin: 0; font-size: 0.9375rem; line-height: 1.55; color: var(--text-2); }
  .sorprese-cta { margin-top: 6px; font-weight: 700; color: var(--cream); }
  .archivio { padding-bottom: 110px; }
  .arch-head { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: flex-end; gap: 12px 24px; border-bottom: 1px solid var(--line); padding-bottom: 18px; margin-bottom: 8px; }
  .arch-head h2 { color: var(--muted); }
  .arch-head span { font-size: 0.875rem; color: var(--muted); }
  .archivio .vuoto { padding: 24px 0; }
  .arch-row { display: flex; flex-wrap: wrap; align-items: center; gap: 14px 24px; padding: 18px 0; border-bottom: 1px solid var(--line); }
  .arch-row img { width: 64px; height: 80px; object-fit: cover; object-position: center top; border-radius: 8px; filter: grayscale(0.6); }
  .arch-data { font-size: 0.9375rem; font-weight: 700; color: var(--text-2); width: 110px; }
  .arch-txt { display: flex; flex-direction: column; gap: 4px; flex: 1 1 280px; }
  .arch-txt .display { font-size: 1.75rem; line-height: 1.05; }
  .arch-luogo { font-size: 0.875rem; color: var(--muted); flex: 0 1 300px; }
  .news-in { padding-top: 90px; padding-bottom: 90px; display: flex; flex-wrap: wrap; gap: 32px; align-items: center; justify-content: space-between; }
  .rosso { color: var(--red); }
  .news .btn-line { color: var(--ink); }
</style>
