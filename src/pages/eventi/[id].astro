---
// Pagina di un singolo evento: una per ogni file in src/content/eventi/,
// all'indirizzo /eventi/<nome del file>/. È il link da condividere: l'anteprima
// mostra la locandina, e Google riconosce i dati dell'evento.
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Testo from '../../components/Testo.astro';
import EventoMini from '../../components/EventoMini.astro';
import { eventiDivisi, inArrivo, inizioIso, inizioOggi, testoBreve } from '../../lib/eventi';
import { u } from '../../lib/url';
import { sito } from '../../data/sito';

export async function getStaticPaths() {
  const eventi = await getCollection('eventi');
  return eventi.map((evento) => ({ params: { id: evento.id }, props: { evento } }));
}

interface Props { evento: CollectionEntry<'eventi'> }
const { evento } = Astro.props;
const d = evento.data;
const { Content } = await render(evento);

const futuro = inArrivo(evento);
const domani = inizioOggi();
domani.setDate(domani.getDate() + 1);
const stato = !futuro ? 'Concluso' : d.data < domani ? 'Oggi' : 'In arrivo';

const locandina = d.locandina ? `img/eventi/${d.locandina}` : undefined;
const titolo = d.sottotitolo ? `${d.titolo} – ${d.sottotitolo}` : d.titolo;
const descrizione = testoBreve(`${d.quando} · ${d.luogo}. ${evento.body ?? ''}`);

// Sotto: i prossimi eventi in calendario, poi i più recenti già passati.
const { futuri, recenti } = await eventiDivisi();
const altri = [...futuri, ...recenti.filter((e) => !inArrivo(e))].filter((e) => e.id !== evento.id).slice(0, 3);

const assoluto = (path = '') => new URL(u(path), Astro.site).href;
const indirizzo = assoluto(`eventi/${evento.id}/`);

// Condivisione: WhatsApp e Facebook sono semplici link, niente script esterni.
const condividi = {
  whatsapp: `https://wa.me/?text=${encodeURIComponent(`${titolo} · ${d.quando}\n${indirizzo}`)}`,
  facebook: `https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(indirizzo)}`,
};

// Dati strutturati schema.org: così Google può mostrare l'evento nei risultati.
const inCitta = d.luogo.includes(sito.citta);
const scheda = {
  '@context': 'https://schema.org',
  '@type': 'Event',
  name: titolo,
  description: testoBreve(evento.body ?? '', 500),
  startDate: inizioIso(evento),
  eventStatus: 'https://schema.org/EventScheduled',
  eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
  location: {
    '@type': 'Place',
    name: d.luogo,
    address: {
      '@type': 'PostalAddress',
      streetAddress: d.luogo,
      addressLocality: inCitta ? sito.citta : undefined,
      postalCode: inCitta ? sito.cap : undefined,
      addressRegion: inCitta ? sito.provincia : undefined,
      addressCountry: 'IT',
    },
  },
  image: locandina ? [assoluto(locandina)] : undefined,
  organizer: { '@type': 'Organization', name: `${sito.nome} ${sito.forma}`, url: assoluto() },
  offers: futuro && d.prenotazione
    ? { '@type': 'Offer', url: d.prenotazione, availability: 'https://schema.org/InStock' }
    : undefined,
  url: indirizzo,
};
---
<Base title={titolo} description={descrizione} image={locandina} current="eventi/">
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(scheda)} />

  <div class="wrap page-head">
    <a href={u('eventi/')} class="indietro">← Tutti gli eventi</a>
    <span class:list={['stato', { 'stato--passato': !futuro }]}>{stato} · {d.tipo}</span>
    <h1 class="display titolo">{d.titolo}{d.sottotitolo && <><br /><span><Testo t={d.sottotitolo} /></span></>}</h1>
  </div>

  <section class="wrap corpo">
    {locandina ? (
      <a href={u(locandina)} class="locandina" target="_blank" rel="noopener" title="Apri la locandina">
        <img src={u(locandina)} alt={`Locandina: ${d.titolo}`} />
      </a>
    ) : (
      <div class="locandina"><img src={u('img/concerto.jpg')} alt="" /></div>
    )}
    <div class="scheda cream">
      <dl class="dati">
        <div><dt>Quando</dt><dd>{d.quando}</dd></div>
        <div><dt>Dove</dt><dd><Testo t={d.luogo} /></dd></div>
        {d.quota && <div><dt>Quota</dt><dd><Testo t={d.quota} /></dd></div>}
      </dl>
      <div class="desc"><Content /></div>
      {d.info.length > 0 && <ul class="info">{d.info.map((r) => <li><Testo t={r} /></li>)}</ul>}
      {!futuro && <p class="concluso">Questo evento si è già svolto. Qui sotto trovi i prossimi.</p>}
      <div class="btn-row">
        {futuro && d.prenotazione && <a href={d.prenotazione} class="btn btn-red" target="_blank" rel="noopener">{d.bottone}</a>}
        <a href={sito.whatsappLink} class="btn btn-line">Info su WhatsApp</a>
      </div>
      <div class="condividi" data-condividi data-link={indirizzo} data-titolo={titolo}>
        <span class="condividi-label">Condividi l’evento</span>
        <div class="condividi-row">
          <a href={condividi.whatsapp} class="btn btn-line share" target="_blank" rel="noopener" aria-label="Condividi su WhatsApp" title="WhatsApp">
            <img src={u('img/social/whatsapp.svg')} alt="" width="22" height="22" />
          </a>
          <a href={condividi.facebook} class="btn btn-line share" target="_blank" rel="noopener" aria-label="Condividi su Facebook" title="Facebook">
            <img src={u('img/social/facebook.png')} alt="" width="22" height="22" />
          </a>
          <button type="button" class="btn btn-line share" data-copia aria-label="Copia il link" title="Copia il link">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path></svg>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" hidden><path d="M5 12.5l4.5 4.5L19 7.5"></path></svg>
          </button>
          <button type="button" class="btn btn-line share" data-altre-app aria-label="Condividi con altre app" title="Altre app" hidden>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="18" cy="5" r="3"></circle><circle cx="6" cy="12" r="3"></circle><circle cx="18" cy="19" r="3"></circle><path d="M8.6 13.5l6.8 4"></path><path d="M15.4 6.5l-6.8 4"></path></svg>
          </button>
          <span class="esito" data-esito aria-live="polite"></span>
        </div>
      </div>
    </div>
  </section>

  {altri.length > 0 && (
    <section class="wrap altri" aria-labelledby="altri-titolo">
      <div class="altri-head">
        <h2 id="altri-titolo" class="display display-m">Altri eventi</h2>
        <a href={u('eventi/')} class="tutti">Tutti gli eventi →</a>
      </div>
      <div class="griglia">{altri.map((e) => <EventoMini evento={e} />)}</div>
    </section>
  )}
</Base>

<script>
  // "Copia link" copia l'indirizzo della pagina; "Altre app" compare solo dove il
  // dispositivo sa condividere da sé (di solito il telefono: Instagram, Telegram…).
  const box = document.querySelector<HTMLElement>('[data-condividi]');
  if (box) {
    const url = box.dataset.link!;
    const title = box.dataset.titolo!;
    // Dopo la copia l'icona del link diventa una spunta e accanto compare un messaggio.
    const copia = box.querySelector<HTMLButtonElement>('[data-copia]')!;
    const [iconaLink, iconaOk] = copia.querySelectorAll('svg');
    const esito = box.querySelector<HTMLElement>('[data-esito]')!;
    copia.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(url);
        esito.textContent = 'Link copiato!';
        iconaLink.toggleAttribute('hidden', true);
        iconaOk.toggleAttribute('hidden', false);
      } catch {
        esito.textContent = 'Copialo dalla barra degli indirizzi';
      }
      setTimeout(() => {
        esito.textContent = '';
        iconaLink.toggleAttribute('hidden', false);
        iconaOk.toggleAttribute('hidden', true);
      }, 2500);
    });
    const altre = box.querySelector<HTMLButtonElement>('[data-altre-app]')!;
    if (navigator.share) {
      altre.hidden = false;
      altre.addEventListener('click', () => navigator.share({ title, url }).catch(() => {}));
    }
  }
</script>

<style>
  .page-head { gap: 22px; padding-bottom: 48px; }
  .indietro { font-size: 0.8125rem; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: var(--muted); text-decoration: none; }
  .stato { font-size: 0.8125rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.12em; background: var(--red); color: #fff; padding: 8px 14px; border-radius: 999px; }
  .stato--passato { background: var(--line); color: var(--text-2); }
  .titolo { font-size: clamp(3rem, 8vw, 7rem); line-height: 0.9; }
  .titolo span { color: var(--red-light); }

  .corpo { display: flex; flex-wrap: wrap; align-items: flex-start; gap: 32px; padding-bottom: 100px; }
  .locandina { flex: 0 1 380px; max-width: 460px; border-radius: 22px; overflow: hidden; background: var(--card); }
  .locandina img { width: 100%; height: auto; }
  .scheda { flex: 999 1 420px; min-width: 0; border-radius: 28px; padding: clamp(24px, 5vw, 56px); display: flex; flex-direction: column; gap: 24px; }
  .dati { margin: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 16px; font-size: 0.9375rem; }
  .dati dt { font-size: 0.8125rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; color: var(--red-dark); }
  .dati dd { margin: 4px 0 0; font-weight: 600; }
  .desc { display: flex; flex-direction: column; gap: 14px; }
  .desc :global(p) { margin: 0; max-width: 36em; font-size: 1.0625rem; line-height: 1.65; color: var(--on-cream); }
  .info { margin: 0; padding-left: 20px; display: flex; flex-direction: column; gap: 8px; font-size: 1rem; line-height: 1.5; color: var(--on-cream); }
  .info li::marker { color: var(--red); }
  .concluso { margin: 0; font-weight: 600; color: var(--red-dark); }
  .scheda .btn-line { color: var(--ink); }
  .condividi { display: flex; flex-direction: column; gap: 12px; padding-top: 22px; border-top: 1px solid rgba(20, 13, 15, 0.15); }
  .condividi-label { font-size: 0.8125rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; color: var(--red-dark); }
  .condividi-row { display: flex; flex-wrap: wrap; align-items: center; gap: 10px; }
  .share { width: 48px; height: 48px; padding: 0; justify-content: center; border-radius: 50%; }
  .share img, .share svg { width: 22px; height: 22px; flex: none; }
  .share[hidden], .share svg[hidden] { display: none; }
  .esito { font-size: 0.9375rem; font-weight: 600; color: var(--red-dark); }

  .altri { padding-bottom: 110px; }
  .altri-head { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: flex-end; gap: 20px; margin-bottom: 32px; }
  .tutti { color: var(--cream); font-weight: 700; font-size: 1.0625rem; }
  .griglia { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(300px, 100%), 1fr)); gap: 20px; }
</style>
