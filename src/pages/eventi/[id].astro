---
// Vecchi indirizzi delle singole pagine, /eventi/<nome del file>/: i link già
// condivisi portano alla pagina nuova, /attivita/<nome del file>/.
import { getCollection, type CollectionEntry } from 'astro:content';
import { linkEvento } from '../../lib/eventi';

export async function getStaticPaths() {
  const eventi = await getCollection('eventi');
  return eventi.map((evento) => ({ params: { id: evento.id }, props: { evento } }));
}

interface Props { evento: CollectionEntry<'eventi'> }
return Astro.redirect(linkEvento(Astro.props.evento), 301);
---
