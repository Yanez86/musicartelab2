---
import Base from '../layouts/Base.astro';
import { eventiDivisi, inArrivo, linkEvento } from '../lib/eventi';
import { u, giorno, meseBreve, dataBreve } from '../lib/url';
import { sito } from '../data/sito';
import Testo from '../components/Testo.astro';
import NuovaScheda from '../components/NuovaScheda.astro';
import Nome from '../components/Nome.astro';
import EventoTop from '../components/EventoTop.astro';

const { recenti, archivio, futuri, principale: top, principaleFuturo: topFuturo } = await eventiDivisi();
const gruppi = [
  {
    id: 'futuri',
    titolo: 'Prossime attività',
    lista: futuri.filter((e) => e.id !== top?.id),
  },
  {
    id: 'passati',
    titolo: 'Attività passate',
    lista: recenti.filter((e) => !inArrivo(e) && e.id !== top?.id),
    vuoto: 'Nessuna attività negli ultimi dodici mesi.',
  },
];
const img = (f?: string) => (f ? u(`img/eventi/${f}`) : u('img/concerto.jpg'));
---
<Base title={`Attività, concerti ed eventi a ${sito.citta}`} current="attivita/" description={`Concerti, jam session, masterclass, incontri e feste di ${sito.nome} a ${sito.citta}: le prossime attività, le prenotazioni e l’archivio.`}>
  <div class="wrap page-head">
    <h1 class="display display-xl">Attività<span class="dot">.</span></h1>
    <p class="lead intro">Palchi, jam, masterclass e feste: la musica di <Nome /> si vive dal vivo.</p>
  </div>

  {top && (
    <section class="wrap" style="margin-bottom: 72px;" aria-label={topFuturo ? 'Prossima attività' : 'La più recente'}>
      <EventoTop evento={top} futuro={topFuturo} />
    </section>
  )}

  {gruppi.map((g) => (
    <section class="wrap gruppo" aria-labelledby={`titolo-${g.id}`}>
      <h2 id={`titolo-${g.id}`} class="display gruppo-titolo">{g.titolo}</h2>
      {g.vuoto && g.lista.length === 0 && <p class="vuoto">{g.vuoto}</p>}
      <div class="griglia">
        {g.lista.map((e) => (
          <article class="ev" id={e.id}>
            <div class="ev-img">
              <img src={img(e.data.locandina)} alt={`Locandina: ${e.data.titolo}`} loading="lazy" />
              <span class="ev-date"><b>{giorno(e.data.data)}</b><small>{meseBreve(e.data.data)}</small></span>
            </div>
            <div class="ev-txt">
              <span class="tag">{e.data.tipo}</span>
              <h3 class="display"><a href={linkEvento(e)} class="ev-link"><Testo t={e.data.titolo} />{e.data.sottotitolo && <> · <Testo t={e.data.sottotitolo} /></>}</a></h3>
              <span class="ev-quando">{e.data.quando}</span>
              <span class="ev-luogo"><Testo t={e.data.luogo} /></span>
              {e.data.info.length > 0 && <ul>{e.data.info.map((r) => <li><Testo t={r} /></li>)}</ul>}
              {g.id === 'futuri' && e.data.prenotazione && <a href={e.data.prenotazione} class="btn btn-red ev-btn" target="_blank" rel="noopener">{e.data.bottone}<NuovaScheda /></a>}
            </div>
          </article>
        ))}
        {g.id === 'futuri' && (
          <a href={sito.instagram} rel="noopener" target="_blank" class="ev sorprese">
            <div class="sorprese-top" aria-hidden="true"><span lang="en">stay<br />tuned</span></div>
            <div class="ev-txt">
              <span class="tag">In arrivo</span>
              <h3 class="display">Altre sorprese</h3>
              <p>{sito.sorprese}</p>
              <span class="sorprese-cta">Seguici su Instagram →</span><NuovaScheda />
            </div>
          </a>
        )}
      </div>
    </section>
  ))}

  <section class="wrap gruppo" aria-labelledby="archivio">
    <div class="arch-head">
      <h2 id="archivio" class="display">Archivio</h2>
      <span>Attività di oltre un anno fa</span>
    </div>
    {archivio.length === 0 && <p class="vuoto">Nessuna attività in archivio.</p>}
    <div class="griglia griglia-archivio">
      {archivio.map((e) => (
        <article class="ev">
          <div class="ev-img" style={`--locandina: url('${img(e.data.locandina)}')`}>
            <img src={img(e.data.locandina)} alt={`Locandina: ${e.data.titolo}`} loading="lazy" />
          </div>
          <div class="ev-txt">
            <span class="ev-quando">{dataBreve(e.data.data)}</span>
            <h3 class="display"><a href={linkEvento(e)} class="ev-link"><Testo t={e.data.titolo} /></a></h3>
          </div>
        </article>
      ))}
    </div>
  </section>
</Base>

<style>
  .gruppo { padding-bottom: var(--spazio-sezione); }
  .gruppo-titolo { font-size: var(--titolo-4); margin-bottom: 24px; }
  .arch-head h2 { font-size: var(--titolo-4); }
  .vuoto { margin: 0; padding-bottom: 12px; font-size: var(--testo-m); color: var(--muted); }
  .griglia { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(280px, 100%), 1fr)); gap: var(--spazio-griglia); }
  .griglia:empty { display: none; }
  .ev { background: var(--card); border: 1px solid var(--line); border-radius: var(--raggio); overflow: hidden; display: flex; flex-direction: column; transition: transform 0.3s, border-color 0.3s; scroll-margin-top: 24px; }
  .ev:hover, .ev:focus-within { transform: translateY(-8px); border-color: var(--red); }
  /* Il link del titolo copre tutta la scheda; il pulsante di prenotazione resta sopra */
  .ev { position: relative; }
  .ev-link { text-decoration: none; }
  .ev-link::after { content: ''; position: absolute; inset: 0; }
  .ev-link:focus-visible { outline: none; }
  .ev-link:focus-visible::after { outline: 3px solid var(--cream); outline-offset: -3px; border-radius: inherit; }
  .ev-img { position: relative; aspect-ratio: 4 / 5; overflow: hidden; background: var(--card-hover); }
  .ev-img img { width: 100%; height: 100%; object-fit: cover; object-position: center top; transition: transform 0.5s; }
  .ev:hover .ev-img img { transform: scale(1.04); }
  .ev-date { position: absolute; left: 16px; top: 16px; box-shadow: 0 8px 20px rgba(0, 0, 0, 0.4); }
  .ev-txt { padding: 24px; display: flex; flex-direction: column; gap: 12px; flex: 1; }
  .ev-btn { margin-top: auto; align-self: flex-start; position: relative; z-index: 1; }
  .ev-txt h3 { font-size: var(--titolo-5); line-height: 1.02; }
  .ev-quando { font-size: var(--testo-s); color: var(--text-2); }
  .ev-luogo { font-size: var(--testo-s); color: var(--muted); }
  .ev-txt ul { margin: 4px 0 0; padding-left: 24px; display: flex; flex-direction: column; gap: 8px; font-size: var(--testo-s); line-height: 1.5; color: #d9cfc9; }
  .ev-txt li::marker { color: var(--red-light); }
  .sorprese { background: transparent; border: 2px dashed var(--cream); text-decoration: none; }
  .sorprese:hover { color: #fff; }
  .sorprese-top { aspect-ratio: 4 / 5; display: grid; place-items: center; background: repeating-linear-gradient(135deg, rgba(237, 227, 209, 0.06) 0 14px, transparent 14px 28px); }
  .sorprese-top span { font-family: var(--script); font-size: clamp(3.5rem, 7vw, 4.75rem); line-height: 0.95; text-align: center; color: var(--cream); transform: rotate(-8deg); }
  .sorprese:hover .sorprese-top span { color: var(--red-light); }
  .sorprese .ev-txt p { margin: 0; font-size: var(--testo-m); line-height: 1.55; color: var(--text-2); }
  .sorprese-cta { margin-top: 8px; font-weight: 700; color: var(--cream); }
  .arch-head { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: flex-end; gap: 12px 24px; border-bottom: 1px solid var(--line); padding-bottom: 16px; margin-bottom: 8px; }
  .arch-head span { font-size: var(--testo-s); color: var(--muted); }
  .griglia-archivio { grid-template-columns: repeat(auto-fill, minmax(min(150px, 100%), 1fr)); gap: 16px; margin-top: 24px; }
  /* Locandine quadrate: al centro, con la stessa immagine sfocata a riempire il box */
  .griglia-archivio .ev-img::before { content: ''; position: absolute; inset: 0; background: var(--locandina) center / cover; filter: blur(12px) brightness(0.85); transform: scale(1.3); }
  .griglia-archivio .ev-img img { position: relative; object-fit: contain; object-position: center; }
  .griglia-archivio .ev-txt { padding: 12px; gap: 4px; }
  .griglia-archivio .ev-txt h3 { font-size: var(--testo-xl); line-height: 1.05; }
</style>
