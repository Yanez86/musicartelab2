---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Camino from '../components/Camino.astro';
import Ritratto from '../components/Ritratto.astro';
import { eventiDivisi } from '../lib/eventi';
import { u, giorno, meseBreve } from '../lib/url';
import { sito } from '../data/sito';
import Nome from '../components/Nome.astro';
import Testo from '../components/Testo.astro';

const corsi = (await getCollection('corsi')).sort((a, b) => a.data.ordine - b.data.ordine);
const insegnanti = (await getCollection('insegnanti')).sort((a, b) => a.data.ordine - b.data.ordine).slice(0, 4);
const { recenti } = await eventiDivisi();
// In home: prima gli eventi in arrivo (dal più vicino), poi i più recenti già passati.
const oggi = new Date();
oggi.setHours(0, 0, 0, 0);
const futuri = recenti.filter((e) => e.data.data >= oggi).sort((a, b) => a.data.data.getTime() - b.data.data.getTime());
const passati = recenti.filter((e) => e.data.data < oggi);
const ultimi = [...futuri, ...passati].slice(0, 3);
const strumenti = ['Canto', 'Chitarra', 'Basso', 'Batteria', 'Pianoforte', 'Ukulele', 'Coro Rock', 'Musichello'];
const giro = [...strumenti, ...strumenti];
const rotazioni = [-3, 2, -2, 3];
const prossimo = futuri[0];
---
<Base overlayHeader>
  <section class="hero" style={`background-image: url(${u('img/splash.jpg')})`}>
    <div class="hero-shade"></div>
    <div class="hero-fade"></div>
    <Camino />
    <div class="wrap hero-body">
      <p class="kicker rise">{sito.forma} · {sito.sottotitolo} · {sito.citta}</p>
      <h1 class="display hero-title rise" style="animation-delay: 0.15s">Fare musica<br /><span class="cream-text">insieme</span><span class="dot">.</span></h1>
      <div class="hero-cta rise" style="animation-delay: 0.3s">
        <p class="hero-lead"><strong>Corsi, eventi e tanto rock.</strong><br />Siamo un’associazione di Merate che insegna musica pop e rock e la porta dal vivo.</p>
        <div class="btn-row">
          <a href={u('corsi/')} class="btn btn-red">Scopri i corsi</a>
          <a href={u('eventi/')} class="btn btn-line">Prossimi eventi</a>
        </div>
      </div>
    </div>
  </section>

  <section class="marquee-band" aria-label="Strumenti">
    <div class="marquee">
      {giro.map((s) => <span>{s}<span class="nota-m" aria-hidden="true">♪</span></span>)}
    </div>
  </section>

  {ultimi.length > 0 && (
    <section class="wrap eventi-home">
      <div class="sec-head">
        <h2 class="display display-l">{futuri.length > 0 ? 'Prossimi' : 'Ultimi'}<br />eventi</h2>
        <a href={u('eventi/')} class="cream-text strong">Tutti gli eventi →</a>
      </div>
      <div class="ev-grid">
        {ultimi.map((e) => (
          <a href={u('eventi/')} class="ev-mini">
            <span class="ev-date"><b>{giorno(e.data.data)}</b><small>{meseBreve(e.data.data)}</small></span>
            <span class="ev-mini-txt">
              <span class="tag">{e.data.tipo}</span>
              <span class="ev-mini-title">{e.data.titolo}{e.data.sottotitolo && <> · <Testo t={e.data.sottotitolo} /></>}</span>
              <span class="ev-mini-luogo"><Testo t={e.data.luogo} /></span>
            </span>
          </a>
        ))}
      </div>
    </section>
  )}

  <section class="wrap corsi-home">
    <div class="sec-head">
      <h2 class="display display-l">I corsi</h2>
      <p class="lead">Lezioni individuali e di gruppo sul repertorio pop rock, {sito.periodoCorsi}, nella sede di {sito.citta}.</p>
    </div>
    <div class="rows">
      {corsi.map((c, i) => (
        <a href={u('corsi/')} class="row">
          <span class="row-n">{String(i + 1).padStart(2, '0')}</span>
          <span class="row-nome">{c.data.nome}</span>
          <span class="row-eta">{c.data.eta}</span>
          <svg class="row-arr" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M5 12h14"></path><path d="M13 6l6 6-6 6"></path></svg>
        </a>
      ))}
    </div>
  </section>

  <section class="wrap sede">
    <div class="sede-foto">
      <img src={u('img/sede.jpg')} alt="Ingresso della sede di Musicarte-lab a Merate" loading="lazy" />
      <div class="sticker">
        <span>Iscrizioni aperte</span>
        <strong>Anno {sito.annoCorsi}</strong>
      </div>
    </div>
    <div class="sede-testo">
      <h2 class="display display-m">Una casa<br />per la musica<br /><span class="dot">a Merate</span></h2>
      <p>Fondata nel {sito.fondazione}, ma con molta strada già percorsa nel mondo dell’insegnamento musicale, <Nome /> nasce dal desiderio di creare uno spazio dove imparare a suonare e cantare, ma anche un luogo da condividere, dove le diverse sensibilità musicali possano crescere e incontrarsi.</p>
      <p>Da settembre a giugno gli allievi vengono seguiti da insegnanti attenti ai punti di forza di ognuno. E l’obiettivo è sempre lo stesso: <strong class="cream-text">il palco.</strong></p>
      <div class="btn-row">
        <a href={u('statuto/')} class="btn btn-line cream-text">Leggi lo statuto</a>
      </div>
    </div>
  </section>

  <section id="band" class="band" aria-labelledby="band-title">
    <div class="band-bg" aria-hidden="true">Band</div>
    <div class="wrap band-grid">
      <div class="band-testo">
        <p class="kicker">Noi miriamo sempre al palco</p>
        <h2 id="band-title" class="display band-title">Musicarte<span class="script cream-text">Band</span></h2>
        <p class="band-lead">Il gruppo ufficiale dell’associazione: allievi e docenti sullo stesso palco per un viaggio nella musica pop rock. La MusicarteBand si esibisce a feste, sagre ed eventi della zona e dal vivo ospita spesso altri “colleghi”.</p>
        <dl class="band-info">
          <div><dt>Formazione</dt><dd>Chitarre, basso, batteria, tastiera e voci</dd></div>
          {prossimo && <div><dt>Prossima data</dt><dd><a href={u('eventi/')}>{prossimo.data.titolo} · {giorno(prossimo.data.data)} {meseBreve(prossimo.data.data)}</a></dd></div>}
          <div><dt>Chi suona</dt><dd>Allievi e docenti, con ospiti dal vivo</dd></div>
        </dl>
        <div class="btn-row">
          <a href={`mailto:${sito.email}?subject=MusicarteBand`} class="btn btn-cream">Suona con la band</a>
          <a href={u('eventi/')} class="btn btn-line">Dove ascoltarla</a>
        </div>
      </div>
      <div class="band-foto">
        <img src={u('img/band.jpg')} alt="La band sul palco durante un concerto all’aperto" loading="lazy" />
        <span class="script">live in Merate</span>
      </div>
    </div>
  </section>

  <section class="cream insegnanti-home">
    <div class="wrap">
      <div class="sec-head">
        <h2 class="display display-l">Gli insegnanti</h2>
      </div>
      <div class="polaroids">
        {insegnanti.map((d, i) => (
          <a href={u(`insegnanti/#${d.id}`)} class="polaroid" style={`--rot: ${rotazioni[i % 4]}deg`}>
            {d.data.foto ? <img src={u(`img/insegnanti/${d.data.foto}`)} alt={d.data.nome} loading="lazy" /> : <Ritratto variante={d.data.ritratto} />}
            <span class="nome">{d.data.nome}</span>
            <span class="strumento">{d.data.strumento}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="wrap cta-finale">
    <h2 class="display display-l">La prima lezione<br /><span class="dot">è gratis.</span></h2>
    <a href={`mailto:${sito.email}?subject=Lezione di prova`} class="btn btn-cream">Prenota ora</a>
  </section>
</Base>

<style>
  .cream-text { color: var(--cream); }
  .strong { font-weight: 700; font-size: 17px; }

  /* Splash */
  .hero { position: relative; min-height: 820px; display: flex; flex-direction: column; background-size: cover; background-position: center 60%; }
  .hero-shade { position: absolute; inset: 0; background: rgba(20, 13, 15, 0.68); }
  .hero-fade { position: absolute; left: 0; right: 0; bottom: 0; height: 260px; background: linear-gradient(to bottom, rgba(20, 13, 15, 0), var(--ink)); }
  .hero-body { position: relative; z-index: 1; flex-grow: 1; width: 100%; padding-top: 150px; padding-bottom: 140px; display: flex; flex-direction: column; justify-content: flex-end; gap: 28px; }
  .hero-title { font-size: clamp(56px, 10.5vw, 160px); line-height: 0.9; letter-spacing: 0.01em; text-shadow: 0.035em 0.035em 0 rgba(0, 0, 0, 0.55); }
  .hero-cta { display: flex; flex-direction: column; align-items: flex-start; gap: 24px; }
  .hero-lead { margin: 0; max-width: 460px; font-size: 19px; line-height: 1.55; color: var(--text-2); }
  .hero-lead strong { color: #fff; font-size: 1.15em; }
  .rise { animation: rise 0.9s cubic-bezier(0.2, 0.7, 0.2, 1) both; }
  @keyframes rise { from { opacity: 0; transform: translateY(40px); } to { opacity: 1; transform: none; } }

  /* Fascia strumenti */
  .marquee-band {
    position: relative; z-index: 5; background: var(--red); height: 94px; display: flex; align-items: center;
    transform: rotate(-1.5deg); margin: -70px -20px 20px; overflow: hidden;
    box-shadow: 0 22px 26px -6px rgba(0, 0, 0, 0.6), 0 -6px 18px rgba(0, 0, 0, 0.35);
  }
  .marquee { display: flex; width: max-content; animation: scorri 32s linear infinite; font-family: var(--display); font-size: 46px; line-height: 1; text-transform: uppercase; white-space: nowrap; }
  .marquee > span { display: flex; align-items: center; gap: 32px; padding-right: 32px; }
  .nota-m { color: var(--cream); }
  @keyframes scorri { from { transform: translateX(0); } to { transform: translateX(-50%); } }

  /* Intestazioni sezione */
  .sec-head { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: flex-end; gap: 20px; margin-bottom: 40px; }

  /* Corsi */
  .corsi-home { padding-top: 110px; padding-bottom: 80px; }
  .rows { border-top: 1px solid var(--line); }
  .row { display: flex; flex-wrap: wrap; align-items: center; gap: 12px 32px; padding: 28px 24px; border-bottom: 1px solid var(--line); text-decoration: none; transition: background 0.25s, padding 0.25s; }
  .row:hover { background: var(--red); color: #fff; padding-left: 44px; }
  .row-n { font-family: var(--display); font-size: 30px; color: var(--red-light); width: 56px; }
  .row:hover .row-n { color: var(--cream); }
  .row-nome { font-family: var(--display); font-size: clamp(38px, 5vw, 66px); line-height: 1; text-transform: uppercase; flex: 1 1 320px; }
  .row-eta { font-size: 16px; color: var(--text-2); flex: 0 1 220px; }
  .row-arr { transition: transform 0.25s; }
  .row:hover .row-arr { transform: translateX(8px) rotate(-45deg); }

  /* Sede */
  .sede { padding-top: 40px; padding-bottom: 120px; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(340px, 100%), 1fr)); gap: 56px; align-items: center; }
  .sede-foto { position: relative; }
  .sede-foto img { width: 100%; height: 560px; object-fit: cover; object-position: center 45%; border-radius: 28px; }
  .sticker { position: absolute; right: -16px; bottom: 40px; background: var(--cream); color: var(--ink); padding: 22px 26px; border-radius: 20px; transform: rotate(3deg); box-shadow: 0 20px 50px rgba(0, 0, 0, 0.45); }
  .sticker span { display: block; font-size: 13px; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: var(--red); }
  .sticker strong { display: block; font-family: var(--display); font-weight: 400; font-size: 36px; text-transform: uppercase; line-height: 1.05; }
  .sede-testo { display: flex; flex-direction: column; gap: 24px; }
  .sede-testo p { margin: 0; font-size: 18px; line-height: 1.65; color: var(--text-2); }

  /* Band */
  .band { background: var(--red); position: relative; overflow: hidden; }
  .band-bg { position: absolute; right: -40px; top: -30px; font-family: var(--display); font-size: 340px; line-height: 0.8; color: rgba(0, 0, 0, 0.12); text-transform: uppercase; white-space: nowrap; }
  .band-grid { position: relative; padding-top: 110px; padding-bottom: 110px; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(360px, 100%), 1fr)); gap: 56px; align-items: center; }
  .band-testo { display: flex; flex-direction: column; gap: 24px; }
  .band-title { font-size: clamp(42px, 9vw, 128px); line-height: 0.88; overflow-wrap: anywhere; text-shadow: 0.035em 0.035em 0 rgba(0, 0, 0, 0.35); }
  .band-lead { margin: 0; font-size: 19px; line-height: 1.6; color: #fbeff1; }
  .band-info { margin: 8px 0 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); gap: 18px; border-top: 1px solid rgba(255, 255, 255, 0.3); padding-top: 22px; }
  .band-info dt { font-size: 13px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em; color: var(--cream); }
  .band-info dd { margin: 6px 0 0; font-weight: 600; }
  .band-foto { position: relative; }
  .band-foto img { width: 100%; height: 520px; object-fit: cover; object-position: 30% 60%; border-radius: 24px; box-shadow: 0 30px 60px rgba(0, 0, 0, 0.4); transform: rotate(2deg); }
  .band-foto span { position: absolute; left: -12px; bottom: 32px; background: var(--ink); color: var(--cream); padding: 14px 20px; border-radius: 14px; transform: rotate(-3deg); font-size: 26px; box-shadow: 0 14px 30px rgba(0, 0, 0, 0.45); }

  /* Insegnanti */
  .insegnanti-home { padding: 110px 0 130px; }
  .polaroids { display: grid; grid-template-columns: repeat(auto-fit, minmax(210px, 1fr)); gap: 32px; }

  /* Eventi */
  .eventi-home { padding-top: 110px; }
  .ev-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(300px, 100%), 1fr)); gap: 20px; }
  .ev-mini { display: flex; gap: 22px; align-items: flex-start; padding: 28px; background: var(--card); border: 1px solid var(--line); border-radius: 24px; text-decoration: none; transition: transform 0.3s; }
  .ev-mini:hover { transform: translateY(-8px); color: #fff; }
  .ev-date { display: flex; flex-direction: column; align-items: center; background: var(--red); border-radius: 14px; padding: 12px 16px; min-width: 56px; }
  .ev-date b { font-family: var(--display); font-weight: 400; font-size: 42px; line-height: 1; }
  .ev-date small { font-size: 13px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em; color: var(--cream); }
  .ev-mini-txt { display: flex; flex-direction: column; gap: 8px; }
  .ev-mini-title { font-family: var(--display); font-size: 30px; line-height: 1.02; text-transform: uppercase; }
  .ev-mini-luogo { font-size: 14px; color: var(--muted); }

  /* Chiusura */
  .cta-finale { padding-top: 120px; padding-bottom: 120px; text-align: center; display: flex; flex-direction: column; align-items: center; gap: 28px; }

  @media (max-width: 760px) {
    .sede-foto img { height: 380px; }
    .band-foto img { height: 380px; }
  }
</style>
