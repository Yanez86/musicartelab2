---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Camino from '../components/Camino.astro';
import Libretto from '../components/Libretto.astro';
import { eventiDivisi, inArrivo, linkEvento } from '../lib/eventi';
import { u, giorno, meseBreve } from '../lib/url';
import { sito } from '../data/sito';
import Nome from '../components/Nome.astro';
import Testo from '../components/Testo.astro';
import EventoTop from '../components/EventoTop.astro';
import EventoMini from '../components/EventoMini.astro';

const corsi = (await getCollection('corsi')).sort((a, b) => a.data.ordine - b.data.ordine);
const { recenti, futuri, principale, principaleFuturo } = await eventiDivisi();
// In home: in grande l'evento principale (il più vicino a oggi), sotto i
// successivi in arrivo e poi i più recenti già passati.
const passati = recenti.filter((e) => !inArrivo(e));
const prossimiAltri = futuri.filter((e) => e.id !== principale?.id);
const recentiPassati = passati.filter((e) => e.id !== principale?.id);
// Schede sotto l'evento principale: prima quelle in arrivo, poi i passati più recenti.
const ultimi = [...prossimiAltri.slice(0, 2), ...recentiPassati].slice(0, 3);
const strumenti = ['Canto', 'Chitarra', 'Basso', 'Batteria', 'Pianoforte', 'Ukulele', 'Coro Rock', 'Musichello'];
const giro = [...strumenti, ...strumenti];
const prossimo = futuri[0];
// Scheda dell'associazione per Google (dati strutturati schema.org).
const assoluto = (path = '') => new URL(u(path), Astro.site).href;
const scheda = {
  '@context': 'https://schema.org',
  '@type': 'EducationalOrganization',
  name: `${sito.nome} ${sito.forma}`,
  description: `Scuola di musica pop e rock a ${sito.citta}: corsi, concerti ed eventi dal vivo.`,
  url: assoluto(),
  logo: assoluto('img/logo.jpg'),
  image: assoluto('img/splash.jpg'),
  email: sito.email,
  telephone: `+39 ${sito.whatsapp}`,
  foundingDate: String(sito.fondazione),
  address: {
    '@type': 'PostalAddress',
    streetAddress: sito.indirizzo,
    postalCode: sito.cap,
    addressLocality: sito.citta,
    addressRegion: sito.provincia,
    addressCountry: 'IT',
  },
  sameAs: [sito.instagram, sito.facebook],
};
---
<Base overlayHeader>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(scheda)} />
  <section class="hero" style={`background-image: url(${u('img/splash.jpg')})`}>
    <div class="hero-shade"></div>
    <div class="hero-fade"></div>
    <Camino />
    <div class="wrap hero-body">
      <p class="kicker rise">{sito.forma} · {sito.sottotitolo} · {sito.citta}</p>
      <h1 class="display hero-title rise" style="animation-delay: 0.15s">Fare musica<br /><span class="cream-text">insieme</span><span class="dot">.</span></h1>
      <div class="hero-cta rise" style="animation-delay: 0.3s">
        <p class="hero-lead"><strong>Corsi, eventi e tanto rock.</strong><br />Siamo un’associazione di Merate che insegna musica pop e rock e la porta dal vivo.</p>
        <div class="btn-row">
          <a href={u('corsi/')} class="btn btn-red">Scopri i corsi</a>
          <a href={u('eventi/')} class="btn btn-line">Prossimi eventi</a>
        </div>
      </div>
    </div>
  </section>

  <section class="marquee-band" aria-label="Strumenti">
    <div class="marquee">
      {giro.map((s, i) => (
        <span aria-hidden={i >= strumenti.length ? 'true' : undefined}>{s}<span class="nota-m" aria-hidden="true">♪</span></span>
      ))}
    </div>
    <button type="button" class="pausa" aria-pressed="false" aria-label="Ferma le animazioni">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M6 5h4v14H6z"></path><path d="M14 5h4v14h-4z"></path></svg>
      <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" hidden><path d="M7 4.5v15l12.5-7.5z"></path></svg>
    </button>
  </section>

  {principale && (
    <section class="wrap eventi-home">
      <div class="sec-head">
        <h2 class="display display-l">Eventi</h2>
        <a href={u('eventi/')} class="cream-text strong">Tutti gli eventi →</a>
      </div>
      {principale && <EventoTop evento={principale} futuro={principaleFuturo} breve livello="h3" />}
      <div class="ev-grid">
        {ultimi.map((e) => <EventoMini evento={e} />)}
      </div>
    </section>
  )}

  <section class="wrap corsi-home">
    <div class="sec-head">
      <h2 class="display display-l">Corsi</h2>
      <p class="lead">Lezioni individuali e di gruppo sul repertorio pop rock, {sito.periodoCorsi}.</p>
    </div>
    <div class="rows">
      {corsi.map((c, i) => (
        <a href={u('corsi/')} class="row">
          <span class="row-n">{String(i + 1).padStart(2, '0')}</span>
          <span class="row-nome"><Testo t={c.data.nome} /></span>
          <span class="row-eta">{c.data.eta}</span>
          <svg class="row-arr" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M5 12h14"></path><path d="M13 6l6 6-6 6"></path></svg>
        </a>
      ))}
    </div>
  </section>

  <section class="wrap sede">
    <div class="sede-foto">
      <img src={u('img/sede.jpg')} alt="Ingresso della sede di Musicarte-lab a Merate" loading="lazy" />
      <div class="sticker">
        <span>Iscrizioni aperte</span>
        <strong>Anno {sito.annoCorsi}</strong>
      </div>
    </div>
    <div class="sede-testo">
      <h2 class="display display-m">Una casa<br />per la musica<br /><span class="dot">a Merate</span></h2>
      <p>Fondata nel {sito.fondazione}, ma con molta strada già percorsa nel mondo dell’insegnamento musicale, <Nome /> nasce dal desiderio di creare uno spazio dove imparare a suonare e cantare, ma anche un luogo da condividere, dove le diverse sensibilità musicali possano crescere e incontrarsi.</p>
      <p>Da settembre a giugno gli allievi vengono seguiti da insegnanti attenti ai punti di forza di ognuno. E l’obiettivo è sempre lo stesso: <strong class="cream-text">il palco.</strong></p>
      <div class="btn-row">
        <a href={u('associazione/')} class="btn btn-line cream-text">Chi siamo</a>
      </div>
    </div>
  </section>

  <section id="band" class="band" aria-labelledby="band-title">
    <div class="band-bg" aria-hidden="true">Band</div>
    <div class="wrap band-grid">
      <div class="band-testo">
        <p class="kicker">Noi miriamo sempre al palco</p>
        <h2 id="band-title" class="display band-title">Musicarte<wbr /><span class="script cream-text">Band</span></h2>
        <p class="band-lead">Il gruppo ufficiale dell’associazione: allievi e docenti sullo stesso palco per un viaggio nella musica pop rock. La MusicarteBand si esibisce a feste, sagre ed eventi della zona e dal vivo ospita spesso altri “colleghi”.</p>
        <dl class="band-info">
          <div><dt>Formazione</dt><dd>Chitarre, basso, batteria, tastiera e voci</dd></div>
          {prossimo && <div><dt>Prossima data</dt><dd><a href={linkEvento(prossimo)}><Testo t={prossimo.data.titolo} /> · {giorno(prossimo.data.data)} {meseBreve(prossimo.data.data)}</a></dd></div>}
          <div><dt>Chi suona</dt><dd>Allievi e docenti, con ospiti dal vivo</dd></div>
        </dl>
        <div class="btn-row">
          <a href={`mailto:${sito.email}?subject=MusicarteBand`} class="btn btn-cream">Suona con la band</a>
          <a href={u('eventi/')} class="btn btn-line">Dove ascoltarla</a>
        </div>
      </div>
      <div class="band-foto">
        <img src={u('img/band.jpg')} alt="La band sul palco durante un concerto all’aperto" loading="lazy" />
        <span class="script" lang="en">live in Merate</span>
      </div>
    </div>
  </section>

  <section class="insegnanti-home">
    <div class="wrap">
      <div class="sec-head">
        <h2 class="display display-l">Insegnanti</h2>
        <p class="lead">Sfoglia il <span lang="en">booklet</span>: ogni insegnante è una traccia.</p>
      </div>
      <Libretto livello="h3" />
    </div>
  </section>

  <section class="wrap cta-finale">
    <h2 class="display display-l">La prima lezione<br /><span class="dot">è gratis.</span></h2>
    <a href={`mailto:${sito.email}?subject=Lezione di prova`} class="btn btn-cream">Prenota ora</a>
  </section>
</Base>

<script>
  // La fascia degli strumenti scorre di continuo: il pulsante ferma (e fa ripartire)
  // tutte le animazioni continue della pagina.
  const pausa = document.querySelector<HTMLButtonElement>('.pausa');
  if (pausa) {
    const [iconaPausa, iconaPlay] = pausa.querySelectorAll('svg');
    pausa.addEventListener('click', () => {
      const ferme = pausa.getAttribute('aria-pressed') !== 'true';
      pausa.setAttribute('aria-pressed', String(ferme));
      document.documentElement.classList.toggle('animazioni-ferme', ferme);
      iconaPausa.toggleAttribute('hidden', ferme);
      iconaPlay.toggleAttribute('hidden', !ferme);
    });
  }
</script>

<style>
  .cream-text { color: var(--cream); }
  .strong { font-weight: 700; font-size: var(--testo-m); }

  /* Splash */
  .hero { position: relative; min-height: 820px; display: flex; flex-direction: column; background-size: cover; background-position: center 60%; }
  .hero-shade { position: absolute; inset: 0; background: rgba(20, 13, 15, 0.68); }
  .hero-fade { position: absolute; left: 0; right: 0; bottom: 0; height: 260px; background: linear-gradient(to bottom, rgba(20, 13, 15, 0), var(--ink)); }
  .hero-body { position: relative; z-index: 1; flex-grow: 1; width: 100%; padding-top: 152px; padding-bottom: 136px; display: flex; flex-direction: column; justify-content: flex-end; gap: 24px; }
  /* Il titolo della home ha una misura sua, pensata per la foto di apertura */
  .hero-title { font-size: clamp(3.5rem, 10.5vw, 10rem); line-height: 0.9; letter-spacing: 0.01em; text-shadow: 0.035em 0.035em 0 rgba(0, 0, 0, 0.55); }
  .hero-cta { display: flex; flex-direction: column; align-items: flex-start; gap: 24px; }
  .hero-lead { margin: 0; max-width: 460px; font-size: var(--testo-l); line-height: 1.55; color: var(--text-2); }
  .hero-lead strong { color: #fff; font-size: var(--testo-xl); }
  .rise { animation: rise 0.9s cubic-bezier(0.2, 0.7, 0.2, 1) both; }
  @keyframes rise { from { opacity: 0; transform: translateY(40px); } to { opacity: 1; transform: none; } }

  /* Fascia strumenti */
  .marquee-band {
    position: relative; z-index: 5; background: var(--red); height: 96px; display: flex; align-items: center;
    transform: rotate(-1.5deg); margin: -72px -20px 24px; overflow: hidden;
    box-shadow: 0 22px 26px -6px rgba(0, 0, 0, 0.6), 0 -6px 18px rgba(0, 0, 0, 0.35);
  }
  .marquee { display: flex; width: max-content; animation: scorri 32s linear infinite; font-family: var(--display); font-size: 2.875rem; line-height: 1; text-transform: uppercase; white-space: nowrap; }
  .marquee > span { display: flex; align-items: center; gap: 32px; padding-right: 32px; }
  .nota-m { color: var(--cream); }
  .pausa {
    position: absolute; z-index: 1; top: 50%; right: max(44px, calc(50% - var(--wrap) / 2 + 24px)); transform: translateY(-50%);
    width: 48px; height: 48px; border-radius: 50%; border: 2px solid var(--cream); background: var(--ink); color: var(--cream);
    display: grid; place-items: center; cursor: pointer;
  }
  @media (prefers-reduced-motion: reduce) { .pausa { display: none; } }
  @keyframes scorri { from { transform: translateX(0); } to { transform: translateX(-50%); } }

  /* Intestazioni sezione */
  .sec-head { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: flex-end; gap: 24px; margin-bottom: var(--spazio-titolo); }

  /* Corsi */
  .corsi-home { padding-top: var(--spazio-sezione); }
  .rows { border-top: 1px solid var(--line); }
  .row { display: flex; flex-wrap: wrap; align-items: center; gap: 12px 32px; padding: 32px 24px; border-bottom: 1px solid var(--line); text-decoration: none; transition: background 0.25s, padding 0.25s; }
  .row:hover { background: var(--red); color: #fff; padding-left: 48px; }
  .row-n { font-family: var(--display); font-size: var(--titolo-5); color: var(--red-light); width: 56px; }
  .row:hover .row-n { color: var(--cream); }
  .row-nome { font-family: var(--display); font-size: var(--titolo-3); line-height: 1; text-transform: uppercase; flex: 1 1 320px; }
  .row-eta { font-size: var(--testo-m); color: var(--text-2); flex: 0 1 220px; }
  .row-arr { transition: transform 0.25s; }
  .row:hover .row-arr { transform: translateX(8px) rotate(-45deg); }

  /* Sede */
  .sede { padding-top: var(--spazio-sezione); padding-bottom: var(--spazio-sezione); display: grid; grid-template-columns: repeat(auto-fit, minmax(min(340px, 100%), 1fr)); gap: var(--spazio-colonne); align-items: center; }
  .sede-foto { position: relative; }
  .sede-foto img { width: 100%; height: 560px; object-fit: cover; object-position: center 45%; border-radius: var(--raggio); }
  .sticker { position: absolute; right: -16px; bottom: 40px; background: var(--cream); color: var(--ink); padding: 24px; border-radius: var(--raggio); transform: rotate(3deg); box-shadow: 0 20px 50px rgba(0, 0, 0, 0.45); }
  .sticker span { display: block; font-size: var(--testo-xs); font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: var(--red); }
  .sticker strong { display: block; font-family: var(--display); font-weight: 400; font-size: 2.25rem; text-transform: uppercase; line-height: 1.05; }
  .sede-testo { display: flex; flex-direction: column; gap: 24px; }
  .sede-testo p { margin: 0; font-size: var(--testo-l); line-height: 1.65; color: var(--text-2); }

  /* Band */
  .band { background: var(--red); position: relative; overflow: hidden; }
  .band-bg { position: absolute; right: -40px; top: -30px; font-family: var(--display); font-size: 21.25rem; line-height: 0.8; color: rgba(0, 0, 0, 0.12); text-transform: uppercase; white-space: nowrap; }
  .band-grid { position: relative; padding-top: var(--spazio-sezione); padding-bottom: var(--spazio-sezione); display: grid; grid-template-columns: repeat(auto-fit, minmax(min(360px, 100%), 1fr)); gap: var(--spazio-colonne); align-items: center; }
  .band-testo { display: flex; flex-direction: column; gap: 24px; }
  .band-title { font-size: var(--titolo-3); line-height: 0.88; text-wrap: balance; text-shadow: 0.035em 0.035em 0 rgba(0, 0, 0, 0.35); }
  .band-lead { margin: 0; font-size: var(--testo-l); line-height: 1.6; color: #fbeff1; }
  .band-info { margin: 8px 0 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); gap: 16px; border-top: 1px solid rgba(255, 255, 255, 0.3); padding-top: 24px; }
  .band-info dt { font-size: var(--testo-xs); font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em; color: var(--cream); }
  .band-info dd { margin: 8px 0 0; font-size: var(--testo-s); font-weight: 600; }
  .band-foto { position: relative; }
  .band-foto img { width: 100%; height: 520px; object-fit: cover; object-position: 30% 60%; border-radius: var(--raggio); box-shadow: 0 30px 60px rgba(0, 0, 0, 0.4); transform: rotate(2deg); }
  .band-foto span { position: absolute; left: -12px; bottom: 32px; background: var(--ink); color: var(--cream); padding: 12px 24px; border-radius: var(--raggio-s); transform: rotate(-3deg); font-size: var(--titolo-5); box-shadow: 0 14px 30px rgba(0, 0, 0, 0.45); }

  /* Insegnanti */
  .insegnanti-home { padding: var(--spazio-sezione) 0; background: radial-gradient(ellipse at 50% 45%, #3a2328 0%, var(--ink) 65%); }

  /* Eventi */
  .eventi-home { padding-top: var(--spazio-sezione); }
  .ev-grid { margin-top: var(--spazio-griglia); display: grid; grid-template-columns: repeat(auto-fit, minmax(min(300px, 100%), 1fr)); gap: var(--spazio-griglia); }

  /* Chiusura */
  .cta-finale { padding-top: var(--spazio-sezione); padding-bottom: var(--spazio-sezione); text-align: center; display: flex; flex-direction: column; align-items: center; gap: 32px; }

  @media (max-width: 760px) {
    .sede-foto img { height: 380px; }
    .band-foto img { height: 380px; }
  }
</style>
