---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { u } from '../lib/url';
import { sito } from '../data/sito';

const corsi = (await getCollection('corsi')).sort((a, b) => a.data.ordine - b.data.ordine);
const formato = ['Bambini, adolescenti e adulti', 'Individuali o piccoli gruppi', 'Orari mattutini, pomeridiani e serali', 'Anche online'];
const altre = ['Workshop', 'Seminari', 'Conferenze', 'Lezioni concerto', 'Teatro', 'Sonorizzazione di spettacoli teatrali'];
const fuoriSede = [
  { t: 'Corsi per le scuole', d: 'Nelle loro sedi: infanzia, primaria, secondaria di primo e secondo grado.' },
  { t: 'Sala di registrazione', d: 'Assistenza a strumentisti e cantanti.' },
  { t: 'Lezioni a domicilio', d: 'Quando venire in sede è complicato.' },
  { t: 'Team building', d: 'Attività musicali per aziende.' },
  { t: 'Concerti e spettacoli', d: 'Concerti, lezioni concerto, spettacoli teatrali e la loro sonorizzazione.' },
  { t: 'Seminari e conferenze', d: 'Incontri di approfondimento su musica e strumenti.' },
];
const filtri = [
  { id: 'tutti', label: 'Tutti' },
  { id: 'bambini', label: 'Bambini' },
  { id: 'ragazzi', label: 'Ragazzi' },
  { id: 'adulti', label: 'Adulti' },
];
---
<Base title="Corsi" current="corsi/">
  <section class="corsi-hero" style={`background-image: url(${u('img/concerto.jpg')})`}>
    <div class="shade"></div>
    <div class="wrap page-head">
      <h1 class="display display-xl">Corsi<span class="dot">.</span></h1>
      <p class="lead">Tutti i corsi sono orientati al pop rock: si studiano e si suonano i brani di Red Hot Chili Peppers, Foo Fighters, Pink Floyd e tanti altri. Lezioni {sito.periodoCorsi} nella sede di {sito.citta}.</p>
    </div>
    <ul class="wrap formato">
      {formato.map((f) => <li>{f}</li>)}
    </ul>
  </section>

  <div class="wrap">
    <div class="filters" role="group" aria-label="Filtra i corsi per età" data-filtri="corsi">
      {filtri.map((f, i) => <button type="button" class="filter" data-filtro={f.id} aria-pressed={i === 0 ? 'true' : 'false'}>{f.label}</button>)}
    </div>
  </div>

  <section class="wrap griglia">
    {corsi.map((c, i) => (
      <article class="corso" data-fasce={c.data.fasce.join(' ')}>
        <div class="corso-top">
          <span class="corso-n">{String(i + 1).padStart(2, '0')}</span>
          <span class="corso-eta">{c.data.eta}</span>
        </div>
        <h2 class="display corso-nome">{c.data.nome}</h2>
        <p class="corso-desc">{c.data.breve}</p>
        <dl class="corso-dati">
          <div><dt>Formula</dt><dd>{c.data.formula}</dd></div>
          <div><dt>Giorni</dt><dd>{c.data.giorni}</dd></div>
          <div><dt>Insegnante</dt><dd><a href={u('insegnanti/')}>{c.data.insegnante}</a></dd></div>
          <div><dt>Quota</dt><dd>{c.data.quota}</dd></div>
        </dl>
        <div class="btn-row">
          <a href={`mailto:${sito.email}?subject=Lezione di prova: ${c.data.nome}`} class="btn btn-red">Prenota la prova</a>
        </div>
      </article>
    ))}
  </section>

  <section class="wrap altre">
    <h2 class="display">E inoltre</h2>
    <ul>{altre.map((a) => <li>{a}</li>)}</ul>
  </section>

  <section class="wrap">
    <div class="novita">
      <span class="novita-tag script">Novità!</span>
      <h2 class="display">Hai un testo?<br /><span>Ti aiutiamo a farlo diventare una canzone.</span></h2>
      <a href={`mailto:${sito.email}?subject=Ho un testo`} class="btn btn-cream">Scrivici</a>
    </div>
  </section>

  <section class="wrap fuori">
    <div class="fuori-head">
      <h2 class="display display-m"><span class="nome-brand">Musicarte-lab</span><br />fuori sede</h2>
      <p class="lead">Portiamo la musica anche nelle scuole, nelle aziende e a casa vostra.</p>
    </div>
    <div class="fuori-grid">
      {fuoriSede.map((f) => <div class="fuori-card"><strong>{f.t}</strong><p>{f.d}</p></div>)}
    </div>
  </section>

  <section class="wrap">
    <div class="band-box">
      <div>
        <p class="kicker">Dopo le lezioni, il palco</p>
        <h2 class="display band-box-title">Suona nella Musicarte<span class="script cream">Band</span></h2>
        <p>Il gruppo ufficiale dell’associazione, con allievi e docenti, porta dal vivo il repertorio pop rock studiato nei corsi. Il nostro obiettivo: imparare a stare in una band e davanti al pubblico.</p>
      </div>
      <a href={u('#band')} class="btn btn-cream">Scopri la band</a>
    </div>
  </section>

  <section class="cream iscrizione">
    <div class="wrap">
      <h2 class="display display-l">Come iscriversi</h2>
      <ol class="passi">
        <li><span>01</span><strong>Lezione di prova</strong><p>Prenota scrivendo a {sito.email} o su WhatsApp e conosci l’insegnante.</p></li>
        <li><span>02</span><strong>Tessera associativa</strong><p>Quota annuale [€ —], come previsto dallo <a href={u('statuto/')}>statuto</a>.</p></li>
        <li><span>03</span><strong>Giorno e orario</strong><p>Al mattino, al pomeriggio o la sera, concordati con l’insegnante, in sede a {sito.citta} o online.</p></li>
      </ol>
      <a href={u(sito.pieghevole)} class="btn btn-dark pieghevole" download>
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 4v11"></path><path d="M7 10l5 5 5-5"></path><path d="M5 20h14"></path></svg>
        Scarica il pieghevole (PDF)
      </a>
    </div>
  </section>
</Base>

<script>
  document.querySelectorAll<HTMLElement>('[data-filtri="corsi"]').forEach((gruppo) => {
    const bottoni = gruppo.querySelectorAll<HTMLButtonElement>('[data-filtro]');
    const corsi = document.querySelectorAll<HTMLElement>('[data-fasce]');
    bottoni.forEach((b) =>
      b.addEventListener('click', () => {
        const f = b.dataset.filtro!;
        bottoni.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
        corsi.forEach((c) => {
          c.hidden = f !== 'tutti' && !c.dataset.fasce!.split(' ').includes(f);
        });
      }),
    );
  });
</script>

<style>
  .corsi-hero { position: relative; background-size: cover; background-position: center 60%; margin-top: -112px; padding-top: 112px; }
  .shade { position: absolute; inset: 0; background: linear-gradient(to bottom, rgba(20, 13, 15, 0.82), var(--ink)); }
  .page-head { position: relative; }
  .filters { padding-top: 8px; padding-bottom: 40px; }
  .griglia { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(360px, 100%), 1fr)); gap: 20px; padding-bottom: 100px; }
  .corso { background: var(--card); border: 1px solid var(--line); border-radius: 24px; padding: clamp(22px, 5vw, 32px); display: flex; flex-direction: column; gap: 18px; transition: transform 0.3s, background 0.3s; }
  .corso:hover { transform: translateY(-8px); background: var(--card-hover); }
  .corso-top { display: flex; justify-content: space-between; align-items: flex-start; gap: 12px; }
  .corso-n { font-family: var(--display); font-size: 28px; color: var(--red-light); }
  .corso-eta { font-size: 13px; font-weight: 700; color: var(--ink); background: var(--cream); padding: 7px 14px; border-radius: 999px; white-space: nowrap; }
  .corso-nome { font-size: clamp(38px, 9vw, 50px); line-height: 0.95; }
  .corso-desc { margin: 0; font-size: 16px; line-height: 1.6; color: #d9cfc9; }
  .corso-dati { margin: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14px 16px; font-size: 14px; border-top: 1px solid var(--line); padding-top: 18px; }
  .corso-dati dt { color: var(--muted); }
  .corso-dati dd { margin: 3px 0 0; font-weight: 600; }
  .band-box { background: var(--red); border-radius: 28px; padding: clamp(28px, 5vw, 48px); display: flex; flex-wrap: wrap; gap: 24px 40px; align-items: center; justify-content: space-between; margin-bottom: 100px; }
  .band-box > div { display: flex; flex-direction: column; gap: 10px; max-width: 720px; }
  .band-box p:last-child { margin: 0; font-size: 17px; line-height: 1.6; color: #fbeff1; }
  .band-box-title { font-size: clamp(36px, 6vw, 72px); line-height: 0.92; overflow-wrap: anywhere; }
  .band-box .cream { background: none; color: var(--cream); }
  .formato { position: relative; list-style: none; margin: -24px auto 0; padding-bottom: 48px; display: flex; flex-wrap: wrap; gap: 10px; }
  .formato li { font-size: 14px; font-weight: 700; padding: 9px 16px; border-radius: 999px; background: rgba(237, 227, 209, 0.12); border: 1px solid rgba(237, 227, 209, 0.35); color: var(--cream); }
  .altre { padding-bottom: 72px; display: flex; flex-wrap: wrap; align-items: baseline; gap: 16px 32px; }
  .altre h2 { font-size: 40px; }
  .altre ul { margin: 0; padding: 0; list-style: none; display: flex; flex-wrap: wrap; gap: 10px 28px; }
  .altre li { font-family: var(--display); font-size: 28px; text-transform: uppercase; color: var(--text-2); }
  .altre li::before { content: '♪ '; color: var(--red-light); }
  .novita { position: relative; background: var(--cream); color: var(--ink); border-radius: 28px; padding: clamp(28px, 5vw, 48px); display: flex; flex-wrap: wrap; gap: 20px 40px; align-items: center; justify-content: space-between; margin-bottom: 100px; }
  .novita-tag { position: absolute; top: -24px; left: 32px; background: var(--red); color: #fff; font-size: 30px; padding: 6px 20px; border-radius: 12px; transform: rotate(-4deg); }
  .novita { padding-top: clamp(64px, 8vw, 80px); }
  .novita h2 { font-size: clamp(40px, 6vw, 72px); line-height: 0.95; }
  .novita h2 span { color: var(--red); font-size: 0.6em; }
  .novita .btn-cream { background: var(--ink); color: #fff; }
  .fuori { padding-bottom: 100px; }
  .fuori-head { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: flex-end; gap: 20px; margin-bottom: 40px; }
  .fuori-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(260px, 100%), 1fr)); gap: 16px; }
  .fuori-card { background: var(--card); border: 1px solid var(--line); border-radius: 20px; padding: 24px; display: flex; flex-direction: column; gap: 8px; }
  .fuori-card strong { font-family: var(--display); font-weight: 400; font-size: 30px; text-transform: uppercase; line-height: 1; }
  .fuori-card p { margin: 0; font-size: 15px; line-height: 1.55; color: #d9cfc9; }
  .pieghevole { margin-top: 48px; }
  .iscrizione { padding: 100px 0 110px; }
  .iscrizione h2 { margin-bottom: 48px; }
  .passi { margin: 0; padding: 0; list-style: none; display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 32px; }
  .passi li { display: flex; flex-direction: column; gap: 12px; border-top: 3px solid var(--ink); padding-top: 20px; }
  .passi span { font-family: var(--display); font-size: 72px; line-height: 1; color: var(--red); }
  .passi strong { font-size: 20px; }
  .passi p { margin: 0; font-size: 16px; line-height: 1.6; color: var(--on-cream); }
  .passi a { color: var(--red); }
</style>
