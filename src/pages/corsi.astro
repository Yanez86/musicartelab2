---
import Base from '../layouts/Base.astro';
import { u } from '../lib/url';
import { sito } from '../data/sito';
import Nome from '../components/Nome.astro';
import Testo from '../components/Testo.astro';
import { corsiInOrdine, insegnantiDel } from '../lib/corsi';
import IconaMail from '../components/IconaMail.astro';

const corsi = await Promise.all((await corsiInOrdine()).map(async (c) => ({ c, insegnanti: await insegnantiDel(c) })));
// encodeURIComponent: senza, la "&" di "Writing & Producing" taglia l'oggetto dell'email
const prova = (nome: string) => `mailto:${sito.email}?subject=${encodeURIComponent(`Lezione di prova: ${nome}`)}`;
const altre = ['Workshop', 'Seminari', 'Lezioni concerto', 'Teatro', 'Sala prove'];
const fuoriSede = [
  { t: 'Corsi per le scuole', d: 'Nelle loro sedi: infanzia, primaria, secondaria di primo e secondo grado.' },
  { t: 'Sala di registrazione', d: 'Assistenza a strumentisti e cantanti.' },
  { t: 'Lezioni a domicilio', d: 'Quando venire in sede è complicato.' },
  { t: 'Team building', d: 'Attività musicali per aziende.' },
  { t: 'Concerti e spettacoli', d: 'Concerti, lezioni concerto, spettacoli teatrali e la loro sonorizzazione.' },
  { t: 'Seminari e conferenze', d: 'Incontri di approfondimento su musica e strumenti.' },
];
---
<Base title={`Corsi di musica a ${sito.citta}`} current="corsi/" description={`Corsi di canto, chitarra, basso, batteria, pianoforte e ukulele a ${sito.citta} per bambini, ragazzi e adulti. Lezioni individuali e di gruppo ${sito.periodoCorsi}.`}>
  <section class="corsi-hero" style={`background-image: url(${u('img/concerto.jpg')})`}>
    <div class="shade"></div>
    <div class="wrap page-head">
      <h1 class="display display-xl">Corsi<span class="dot">.</span></h1>
      <p class="lead intro">Impara a suonare e cantare la musica che ami.</p>
    </div>
  </section>

  <section class="wrap">
    <div class="info-corsi cream">
      <h2 class="display">Info utili</h2>
      <p>I corsi annuali sono di 30 lezioni.<br />Le lezioni individuali durano 45 minuti o 1 ora, quelle di coppia 1 ora o 1 ora e 30 minuti, quelle in trio 1 ora e 30 minuti. Ci sono anche lezioni di gruppo e pacchetti specifici.<br />Possiamo concordare soluzioni comode per esigenze specifiche.</p>
    </div>
  </section>

  <section class="wrap griglia">
    {corsi.map(({ c, insegnanti }, i) => (
      <article id={c.id} class="corso">
        <div class="corso-top">
          <span class="corso-n">{String(i + 1).padStart(2, '0')}</span>
          <span class="corso-eta">{c.data.eta}</span>
        </div>
        <h2 class="display corso-nome"><Testo t={c.data.nome} /></h2>
        <p class="corso-desc">{c.data.breve}</p>
        <dl class="corso-dati">
          <div>
            <dt>{insegnanti.length > 1 ? 'Insegnanti' : 'Insegnante'}</dt>
            <dd>{insegnanti.length ? insegnanti.map((ins, k) => <>{k > 0 && ', '}<a href={u(`insegnanti/#${ins.id}`)}>{ins.data.nome}</a></>) : 'Da definire'}</dd>
          </div>
        </dl>
        <div class="btn-row">
          <a href={prova(c.data.nome)} class="btn btn-red"><IconaMail />Prenota la prova</a>
        </div>
      </article>
    ))}
  </section>

  <section class="wrap altre">
    <h2 class="display">E inoltre</h2>
    <ul>{altre.map((a) => <li>{a}</li>)}</ul>
  </section>

  <section class="wrap">
    <div class="novita">
      <span class="novita-tag script">Novità!</span>
      <h2 class="display">Hai un testo?<br /><span>Ti aiutiamo a farlo diventare una canzone.</span></h2>
      <a href={`mailto:${sito.email}?subject=Ho un testo`} class="btn btn-red"><IconaMail />Scrivici</a>
    </div>
  </section>

  <section id="fuori-sede" class="wrap fuori">
    <div class="fuori-head">
      <h2 class="display display-m"><span class="nome-brand">Musicarte-lab</span><br />fuori sede</h2>
      <p class="lead">Portiamo la musica anche nelle scuole, nelle aziende e a casa vostra.</p>
    </div>
    <div class="fuori-grid">
      {fuoriSede.map((f) => <div class="fuori-card"><strong>{f.t}</strong><p>{f.d}</p></div>)}
    </div>
  </section>

  <section id="iscrizione" class="cream iscrizione">
    <div class="wrap">
      <h2 class="display display-l">Come iscriversi</h2>
      <ol class="passi">
        <li><span>01</span><strong>Lezione di prova</strong><p>Prenota scrivendo a {sito.email} o su WhatsApp e conosci l’insegnante.</p></li>
        <li><span>02</span><strong>Tessera associativa</strong><p>Quota annuale {sito.quotaTessera}, come previsto dallo <a href={u('statuto/')}>statuto</a>.</p></li>
        <li><span>03</span><strong>Giorno e orario</strong><p>Al mattino, al pomeriggio o la sera, concordati con l’insegnante.</p></li>
      </ol>
    </div>
  </section>
</Base>

<style>
  .corsi-hero { position: relative; background-size: cover; background-position: center 60%; margin-top: -112px; padding-top: 112px; }
  .shade { position: absolute; inset: 0; background: linear-gradient(to bottom, rgba(20, 13, 15, 0.82), var(--ink)); }
  .page-head { position: relative; }
  .info-corsi { border-radius: var(--raggio); padding: var(--spazio-riquadro); margin-bottom: var(--spazio-titolo); display: flex; flex-direction: column; gap: 16px; }
  .info-corsi h2 { font-size: var(--titolo-4); line-height: 0.95; }
  .info-corsi p { margin: 0; font-size: var(--testo-l); line-height: 1.65; color: var(--on-cream); }
  /* 1 colonna sul telefono, 2 sul tablet, 4 da 1280px: sotto, "MUSICHELLO" non sta in una scheda */
  .griglia { display: grid; grid-template-columns: minmax(0, 1fr); gap: var(--spazio-griglia); padding-bottom: var(--spazio-sezione); }
  @media (min-width: 720px) { .griglia { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 1280px) { .griglia { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
  .corso { background: var(--card); border: 1px solid var(--line); border-radius: var(--raggio); padding: var(--spazio-scheda); display: flex; flex-direction: column; gap: 16px; transition: transform 0.3s, background 0.3s; scroll-margin-top: 24px; }
  .corso:hover { transform: translateY(-8px); background: var(--card-hover); }
  .corso-top { display: flex; justify-content: space-between; align-items: flex-start; gap: 12px; }
  .corso-n { font-family: var(--display); font-size: var(--titolo-5); color: var(--red-light); }
  .corso-eta { font-size: var(--testo-xs); font-weight: 700; color: var(--ink); background: var(--cream); padding: 8px 16px; border-radius: 999px; white-space: nowrap; }
  .corso-nome { font-size: var(--titolo-4); line-height: 0.95; }
  .corso-desc { margin: 0; font-size: var(--testo-m); line-height: 1.6; color: #d9cfc9; }
  .corso-dati { margin: 0; font-size: var(--testo-s); border-top: 1px solid var(--line); padding-top: 16px; }
  .corso-dati dt { color: var(--muted); }
  .corso-dati dd { margin: 4px 0 0; font-weight: 600; }
  .corso .btn-row { margin-top: auto; }
  .altre { padding-bottom: var(--spazio-sezione); display: flex; flex-wrap: wrap; align-items: baseline; gap: 16px 32px; }
  .altre h2 { font-size: var(--titolo-4); }
  .altre ul { margin: 0; padding: 0; list-style: none; display: flex; flex-wrap: wrap; gap: 8px 32px; }
  .altre li { font-family: var(--display); font-size: var(--titolo-5); text-transform: uppercase; color: var(--text-2); }
  .altre li::before { content: '♪ '; color: var(--red-light); }
  .novita { position: relative; background: var(--cream); color: var(--ink); border-radius: var(--raggio); padding: var(--spazio-riquadro); display: flex; flex-wrap: wrap; gap: 24px 40px; align-items: center; justify-content: space-between; margin-bottom: var(--spazio-sezione); }
  .novita-tag { position: absolute; top: -24px; left: 32px; background: var(--red); color: #fff; font-size: var(--titolo-5); padding: 8px 24px; border-radius: var(--raggio-s); transform: rotate(-4deg); }
  .novita { padding-top: clamp(64px, 8vw, 80px); }
  .novita h2 { font-size: var(--titolo-3); line-height: 0.95; }
  .novita h2 span { color: var(--red); font-size: 0.6em; }
  .fuori { padding-bottom: var(--spazio-sezione); }
  .fuori-head { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: flex-end; gap: 24px; margin-bottom: var(--spazio-titolo); }
  .fuori-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(260px, 100%), 1fr)); gap: var(--spazio-griglia); }
  .fuori-card { background: var(--card); border: 1px solid var(--line); border-radius: var(--raggio); padding: var(--spazio-scheda); display: flex; flex-direction: column; gap: 8px; }
  .fuori-card strong { font-family: var(--display); font-weight: 400; font-size: var(--titolo-5); text-transform: uppercase; line-height: 1; }
  .fuori-card p { margin: 0; font-size: var(--testo-m); line-height: 1.55; color: #d9cfc9; }
  .iscrizione { padding: var(--spazio-sezione) 0; }
  .iscrizione h2 { margin-bottom: var(--spazio-titolo); }
  .passi { margin: 0; padding: 0; list-style: none; display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 32px; }
  .passi li { display: flex; flex-direction: column; gap: 12px; border-top: 3px solid var(--ink); padding-top: 24px; }
  .passi span { font-family: var(--display); font-size: 4.5rem; line-height: 1; color: var(--red); }
  .passi strong { font-size: var(--testo-xl); }
  .passi p { margin: 0; font-size: var(--testo-m); line-height: 1.6; color: var(--on-cream); }
  .passi a { color: var(--red); }
</style>
