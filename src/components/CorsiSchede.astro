---
// Le aree dei corsi in home come schede piccole in griglia (numero, nome, età),
// numerate nell'ordine dato. Ognuna porta alla sua scheda nella pagina Corsi.
import Testo from './Testo.astro';

interface Area { nome: string; eta: string; href: string; corpo?: string }
interface Props { aree: Area[] }
const { aree } = Astro.props;
---
<ul class="schede">
  {aree.map((s, i) => (
    <li>
      <a href={s.href} class="scheda">
        <span class="scheda-txt">
          <span class="scheda-n" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
          <span class="scheda-nome"><Testo t={s.nome} /></span>
          {s.corpo && <span class="scheda-corpo">{s.corpo}</span>}
        </span>
        <span class="scheda-fondo">
          <span class="scheda-eta">{s.eta}</span>
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M5 12h14"></path><path d="M13 6l6 6-6 6"></path></svg>
        </span>
      </a>
    </li>
  ))}
</ul>

<style>
  /* Le quattro aree: 2 colonne fino al tablet, poi 4, così non resta una scheda da sola */
  .schede { margin: 0; padding: 0; list-style: none; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }
  @media (min-width: 720px) { .schede { gap: var(--spazio-griglia); } }
  @media (min-width: 1200px) { .schede { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
  .schede li { display: flex; }
  .scheda {
    flex: 1; display: flex; flex-direction: column; justify-content: space-between; gap: 16px;
    min-height: 152px; padding: 16px; background: var(--card); border: 1px solid var(--line); border-radius: var(--raggio);
    text-decoration: none; transition: transform 0.3s, border-color 0.3s;
  }
  .scheda:hover { transform: translateY(-8px); border-color: var(--red); color: #fff; }
  .scheda-fondo { display: flex; justify-content: space-between; align-items: flex-end; gap: 8px; }
  .scheda-fondo svg { flex: none; }
  .scheda-n { font-family: var(--display); font-size: 1.5rem; line-height: 1; color: var(--red-light); }
  .scheda-txt { display: flex; flex-direction: column; gap: 4px; }
  /* Sul telefono il nome si adatta alla larghezza: "FUNZIONALE" deve stare in una scheda anche a 320px */
  .scheda-nome { font-family: var(--display); font-size: clamp(1.25rem, 7.2vw - 3px, 1.5rem); line-height: 1; text-transform: uppercase; overflow-wrap: break-word; }
  .scheda-eta, .scheda-corpo { font-size: var(--testo-xs); line-height: 1.4; color: var(--muted); }
  @media (min-width: 720px) {
    .scheda { min-height: 200px; padding: 24px; }
    .scheda-n, .scheda-nome { font-size: var(--titolo-5); }
    .scheda-txt { gap: 8px; }
    .scheda-eta, .scheda-corpo { font-size: var(--testo-s); }
  }
</style>
