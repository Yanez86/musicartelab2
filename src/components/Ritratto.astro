---
// Illustrazione segnaposto usata finché un insegnante non ha la sua foto.
interface Props { variante?: number; label?: string }
const { variante = 0, label = 'Ritratto illustrato segnaposto' } = Astro.props;

const S = 'M62 108 C60 70 80 58 100 58 C122 58 140 70 138 108 C132 88 118 80 100 80 C82 80 68 88 62 108 Z';
const N = 'M0 0';
const L = 'M58 110 C56 64 82 54 100 54 C118 54 144 64 142 110 L146 180 L54 180 Z';
const F = 'M64 100 C66 72 84 62 100 62 C118 62 134 72 136 100 C120 86 84 84 64 100 Z';
const B = 'M68 118 C70 150 86 156 100 156 C114 156 130 150 132 118 C124 136 112 140 100 140 C88 140 76 136 68 118 Z';
const C = 'M60 112 C50 90 60 60 80 56 C90 44 112 44 122 56 C142 60 150 90 140 112 C134 92 120 84 100 84 C80 84 66 92 60 112 Z';
const U = 'M80 34 a20 20 0 1 0 40 0 a20 20 0 1 0 -40 0 Z';
const looks = [
  { bg: '#9B1B30', skin: '#E8B98F', shirt: '#140D0F', hair: '#3B2A22', back: N, top: S },
  { bg: '#6B625C', skin: '#C98E66', shirt: '#EDE3D1', hair: '#1F1714', back: L, top: F },
  { bg: '#C8475C', skin: '#F1CBA8', shirt: '#2F3A4A', hair: '#8A5A2B', back: U, top: S },
  { bg: '#2F3A4A', skin: '#8D5B3E', shirt: '#9B1B30', hair: '#1F1714', back: N, top: B },
  { bg: '#3E6B5A', skin: '#E3A87F', shirt: '#EDE3D1', hair: '#4A2E1E', back: N, top: C },
  { bg: '#9B1B30', skin: '#F1CBA8', shirt: '#6B625C', hair: '#B8865A', back: L, top: F },
  { bg: '#2F3A4A', skin: '#C98E66', shirt: '#C8475C', hair: '#2A2A2A', back: N, top: S },
  { bg: '#6B625C', skin: '#E8B98F', shirt: '#9B1B30', hair: '#3B2A22', back: N, top: B },
];
const l = looks[variante % looks.length];
---
<svg viewBox="0 0 200 250" role="img" aria-label={label}>
  <rect width="200" height="250" fill={l.bg}></rect>
  <path d={l.back} fill={l.hair}></path>
  <rect x="88" y="138" width="24" height="40" fill={l.skin}></rect>
  <path d="M28 250 C28 192 68 170 100 170 C132 170 172 192 172 250 Z" fill={l.shirt}></path>
  <ellipse cx="100" cy="108" rx="36" ry="42" fill={l.skin}></ellipse>
  <path d={l.top} fill={l.hair}></path>
</svg>
