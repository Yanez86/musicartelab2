---
// Le etichette dei corsi, ognuna con il link alla pagina del corso.
// In home hanno sopra i filtri per età (`filtri`); nella pagina di un corso
// mostrano gli altri corsi.
import type { CollectionEntry } from 'astro:content';
import Testo from './Testo.astro';
import { linkCorso, nomiFasce } from '../lib/corsi';

interface Props { corsi: CollectionEntry<'corsi'>[]; filtri?: boolean }
const { corsi, filtri = false } = Astro.props;
---
<div data-etichette>
  {filtri && (
    <div class="filtri-bar">
      <span class="filtri-label" aria-hidden="true">Per chi è</span>
      <div class="filters" role="group" aria-label="Filtra i corsi per età">
        <button type="button" class="filter" data-filtro="tutti" aria-pressed="true">Tutti</button>
        {Object.entries(nomiFasce).map(([id, nome]) => (
          <button type="button" class="filter" data-filtro={id} aria-pressed="false">{nome}</button>
        ))}
      </div>
      <span class="conteggio" aria-live="polite" data-conteggio>{corsi.length} corsi</span>
    </div>
  )}
  <ul class="etichette">
    {corsi.map((c) => (
      <li data-fasce={c.data.fasce.join(' ')}><a href={linkCorso(c)} class="etichetta"><Testo t={c.data.nome} /></a></li>
    ))}
  </ul>
</div>

<script>
  // Filtri per età: restano solo i corsi della fascia scelta e accanto
  // ai pulsanti si legge quanti sono (anche con lo screen reader).
  const per: Record<string, string> = { tutti: '', bambini: ' per i bambini', ragazzi: ' per i ragazzi', adulti: ' per gli adulti' };
  document.querySelectorAll<HTMLElement>('[data-etichette]').forEach((root) => {
    const bottoni = root.querySelectorAll<HTMLButtonElement>('[data-filtro]');
    const voci = root.querySelectorAll<HTMLElement>('[data-fasce]');
    const conteggio = root.querySelector<HTMLElement>('[data-conteggio]');
    bottoni.forEach((b) =>
      b.addEventListener('click', () => {
        const f = b.dataset.filtro!;
        bottoni.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
        let n = 0;
        voci.forEach((v) => {
          v.hidden = f !== 'tutti' && !v.dataset.fasce!.split(' ').includes(f);
          if (!v.hidden) n++;
        });
        if (conteggio) conteggio.textContent = `${n} ${n === 1 ? 'corso' : 'corsi'}${per[f]}`;
      }),
    );
  });
</script>

<style>
  .filtri-bar { display: flex; flex-wrap: wrap; align-items: center; gap: 12px 24px; margin-bottom: 24px; }
  .filtri-label { font-size: var(--testo-xs); font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: var(--muted); }
  .conteggio { font-size: var(--testo-s); color: var(--muted); }
  .etichette { margin: 0; padding: 0; list-style: none; display: flex; flex-wrap: wrap; gap: 12px; }
  /* 24px sul telefono, 30px (titolo delle schede) sugli schermi larghi */
  .etichetta {
    display: inline-flex; align-items: center; min-height: 48px; padding: 12px 24px;
    border: 2px solid var(--line-strong); border-radius: 999px;
    font-family: var(--display); font-size: clamp(1.5rem, 2.4vw, var(--titolo-5)); line-height: 1; text-transform: uppercase; text-decoration: none;
    transition: background 0.2s, border-color 0.2s;
  }
  .etichetta:hover { background: var(--red); border-color: var(--red); color: #fff; }
  @media (max-width: 600px) {
    .etichette { gap: 8px; }
    .etichetta { padding: 8px 16px; }
  }
</style>
