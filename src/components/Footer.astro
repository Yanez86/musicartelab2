---
import { sito } from '../data/sito';
import { u } from '../lib/url';

// Icone generiche (non i loghi ufficiali): per usare quelli ufficiali
// scaricateli dai kit per i brand di Meta e sostituite gli <svg> qui sotto.
const social = [
  { href: sito.instagram, label: 'Instagram', handle: '@musicartelab', icon: 'camera' },
  { href: sito.facebook, label: 'Facebook', handle: 'Musicarte-Lab APS', icon: 'people' },
  { href: sito.whatsappLink, label: 'WhatsApp', handle: sito.whatsapp, icon: 'chat' },
];
---
<footer class="site-footer">
  <div class="wrap">
    <section class="social" aria-labelledby="social-title">
      <h2 id="social-title" class="display">I nostri social</h2>
      <ul>
        {social.map((s) => (
          <li>
            <a href={s.href} rel="noopener" target="_blank">
              <span class="ico" aria-hidden="true">
                {s.icon === 'camera' && (
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="5"></rect><circle cx="12" cy="12" r="4"></circle><circle cx="17.5" cy="6.5" r="0.6" fill="currentColor"></circle></svg>
                )}
                {s.icon === 'people' && (
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="8" r="3.2"></circle><path d="M3 20c0-3.3 2.7-6 6-6s6 2.7 6 6"></path><circle cx="17" cy="9" r="2.4"></circle><path d="M15.5 14.3c3 .1 5.5 2.4 5.5 5.7"></path></svg>
                )}
                {s.icon === 'chat' && (
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M20 11.5a8 8 0 0 1-11.6 7.1L4 20l1.4-4.2A8 8 0 1 1 20 11.5z"></path></svg>
                )}
              </span>
              <span class="txt"><b>{s.label}</b><small>{s.handle}</small></span>
            </a>
          </li>
        ))}
      </ul>
    </section>
    <div class="cols">
      <div>
        <strong>Sede</strong>
        <span>{sito.citta}, {sito.indirizzo}</span>
        <span>{sito.nome} {sito.forma} · C.F. {sito.codiceFiscale}</span>
      </div>
      <div>
        <strong>Contatti</strong>
        <a href={`mailto:${sito.email}`}>{sito.email}</a>
        <a href={sito.whatsappLink}>WhatsApp {sito.whatsapp}</a>
      </div>
      <div>
        <strong>Associazione</strong>
        <a href={u('statuto/')}>Statuto</a>
        <a href={u('sostienici/')}>Sostienici · 5x1000</a>
        <a href="#">Privacy</a>
      </div>
    </div>
    <div class="bigname" aria-hidden="true">Musicarte<span class="script">lab</span></div>
  </div>
</footer>

<style>
  .social { padding-top: 64px; padding-bottom: 8px; display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 24px 40px; }
  .social h2 { font-size: clamp(40px, 6vw, 64px); }
  .social ul { margin: 0; padding: 0; list-style: none; display: flex; flex-wrap: wrap; gap: 14px; }
  .social a { display: flex; align-items: center; gap: 14px; padding: 10px 22px 10px 10px; border: 2px solid var(--line-strong); border-radius: 999px; text-decoration: none; transition: border-color 0.25s, background 0.25s; }
  .social a:hover { border-color: var(--red); background: var(--card-hover); color: #fff; }
  .ico { width: 52px; height: 52px; border-radius: 50%; background: var(--red); display: grid; place-items: center; transition: transform 0.25s; }
  .social a:hover .ico { transform: rotate(-8deg) scale(1.06); }
  .ico svg { width: 26px; height: 26px; color: #fff; }
  .txt { display: flex; flex-direction: column; line-height: 1.25; }
  .txt b { font-size: 16px; }
  .txt small { font-size: 13px; color: var(--muted); }
</style>
