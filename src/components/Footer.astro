---
import { sito } from '../data/sito';
import { u } from '../lib/url';

// Icone ufficiali dai kit brand di Meta (public/img/social/), usate nei
// colori originali come chiedono le linee guida: non vanno ricolorate.
const social = [
  { href: sito.instagram, label: 'Instagram', handle: '@musicartelab', icon: 'img/social/instagram.png' },
  { href: sito.facebook, label: 'Facebook', handle: 'Musicarte-Lab APS', icon: 'img/social/facebook.png' },
  { href: sito.whatsappLink, label: 'WhatsApp', handle: sito.whatsapp, icon: 'img/social/whatsapp.svg' },
];
---
<footer class="site-footer">
  <div class="wrap">
    <section class="social" aria-labelledby="social-title">
      <h2 id="social-title" class="display">I nostri social</h2>
      <ul>
        {social.map((s) => (
          <li>
            <a href={s.href} rel="noopener" target="_blank" aria-label={`${s.label}: ${s.handle}`} title={s.label}>
              <img src={u(s.icon)} alt="" width="34" height="34" loading="lazy" />
            </a>
          </li>
        ))}
      </ul>
    </section>
    <div class="cols">
      <div>
        <strong>Sede</strong>
        <span>{sito.citta}, {sito.indirizzo}</span>
        <span>{sito.nome} {sito.forma} · C.F. {sito.codiceFiscale}</span>
      </div>
      <div>
        <strong>Contatti</strong>
        <a href={`mailto:${sito.email}`}>{sito.email}</a>
        <a href={sito.whatsappLink}>WhatsApp {sito.whatsapp}</a>
      </div>
      <div>
        <strong>Associazione</strong>
        <a href={u('statuto/')}>Statuto</a>
        <a href={u('sostienici/')}>Sostienici · 5x1000</a>
        <a href="#">Privacy</a>
      </div>
    </div>
    <div class="bigname" aria-hidden="true">Musicarte<span class="script">lab</span></div>
  </div>
</footer>

<style>
  .social { padding-top: 64px; padding-bottom: 8px; display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 24px 40px; }
  .social h2 { font-size: clamp(40px, 6vw, 64px); }
  .social ul { margin: 0; padding: 0; list-style: none; display: flex; flex-wrap: wrap; gap: 14px; }
  .social a { width: 60px; height: 60px; border-radius: 50%; background: #fff; display: grid; place-items: center; transition: transform 0.25s, box-shadow 0.25s; }
  .social a:hover { transform: translateY(-4px) scale(1.06); box-shadow: 0 10px 24px rgba(0, 0, 0, 0.4); }
  .social img { width: 34px; height: 34px; object-fit: contain; }
</style>
