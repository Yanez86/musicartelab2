---
// Mostra un testo (per esempio un campo di un evento) mettendo in evidenza
// ogni "Musicarte-lab" con lo stile del nome dell'associazione.
import { sito } from '../data/sito';
interface Props { t?: string }
const { t = '' } = Astro.props;
const pezzi = t.split(new RegExp(`(${sito.nome.replace(/[-]/g, '\\-')})`, 'g'));
---
{pezzi.map((p) => (p === sito.nome ? <strong class="nome-brand">{p}</strong> : p))}
