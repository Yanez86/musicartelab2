---
// Il libretto CD degli insegnanti: foto a sinistra, note di copertina a
// destra, tracklist sotto. Usato in home e nella pagina Insegnanti.
import { getCollection, render } from 'astro:content';
import { u } from '../lib/url';
import { sito } from '../data/sito';
import Nome from './Nome.astro';

// `livello`: h3 quando il libretto sta sotto un titolo di sezione (in home).
interface Props { aggiornaIndirizzo?: boolean; livello?: 'h2' | 'h3' }
const { aggiornaIndirizzo = false, livello: Titolo = 'h2' } = Astro.props;
const lista = (await getCollection('insegnanti')).sort((a, b) => a.data.ordine - b.data.ordine);
const insegnanti = await Promise.all(lista.map(async (d) => ({ d, Bio: (await render(d)).Content })));
const n = insegnanti.length;
const nn = (i: number) => String(i + 1).padStart(2, '0');
const anno = sito.annoCorsi.replace(/[\[\]]/g, '');
---
<section class="lettore" aria-label="Libretto degli insegnanti" data-libretto data-hash={aggiornaIndirizzo ? "1" : undefined}>
  <div class="comandi">
    <span class="kicker">Liner notes</span>
    <div class="tasti">
      <button type="button" class="tasto" data-prev aria-label="Insegnante precedente"><svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M6 5h2v14H6z"></path><path d="M20 5v14L9 12z"></path></svg></button>
      <button type="button" class="tasto" data-next aria-label="Insegnante successivo"><svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M16 5h2v14h-2z"></path><path d="M4 5v14l11-7z"></path></svg></button>
    </div>
  </div>

  <div class="palco">
    <div class="disco" aria-hidden="true">
      <div class="solchi"></div>
      <div class="etichetta"><img src={u('img/logo.jpg')} alt="" /></div>
      <div class="foro"></div>
    </div>

    {insegnanti.map(({ d, Bio }, i) => (
      <article class="libretto" id={d.id} data-pagina={i} hidden={i !== 0} aria-label={`${d.data.nome}, ${d.data.strumento}`}>
        <div class="foto">
          {d.data.foto ? (
            <img src={u(`img/insegnanti/${d.data.foto}`)} alt={`Foto di ${d.data.nome}, insegnante di ${d.data.strumento.toLowerCase()}`} loading={i === 0 ? 'eager' : 'lazy'} />
          ) : (
            <div class="senza-foto"><span class="grande">{nn(i)}</span><span class="script">foto in arrivo</span></div>
          )}
          <span class="track">Track {nn(i)}</span>
        </div>
        <div class="note">
          <div class="note-top"><span>{nn(i)} · {d.data.strumento}</span><span><Nome /> · {anno}</span></div>
          <Titolo class="display note-nome">{d.data.nome}</Titolo>
          {d.data.ruolo && <span class="ruolo script">{d.data.ruolo}</span>}
          <div class="bio"><Bio /></div>
          <dl class="crediti">
            <dt>Insegna</dt><dd>{d.data.insegna ?? d.data.strumento}</dd>
            <dt>Sede</dt><dd>{sito.indirizzo}, {sito.citta}</dd>
            <dt>Ascolta</dt><dd>{d.data.ascolta}</dd>
          </dl>
          <span class="pagina">pag. {i + 1} / {n}</span>
        </div>
      </article>
    ))}
  </div>

  <p class="sr-only" aria-live="polite" data-annuncio></p>

  <div class="tracklist">
    <div class="tl-head"><span>Tracklist</span><span>{n} insegnanti</span></div>
    <ol>
      {insegnanti.map(({ d }, i) => (
        <li>
          <button type="button" data-traccia={i} aria-current={i === 0 ? 'true' : 'false'}>
            <span class="tl-n">{nn(i)}</span>
            <span class="tl-nome">{d.data.nome}</span>
            <span class="tl-str">{d.data.strumento}</span>
          </button>
        </li>
      ))}
    </ol>
  </div>
</section>


<script>
  document.querySelectorAll<HTMLElement>('[data-libretto]').forEach((root) => {
    const pagine = [...root.querySelectorAll<HTMLElement>('[data-pagina]')];
    const tracce = [...root.querySelectorAll<HTMLButtonElement>('[data-traccia]')];
    const annuncio = root.querySelector<HTMLElement>('[data-annuncio]')!;
    let attuale = 0;
    const mostra = (i: number, aggiornaIndirizzo = true) => {
      attuale = (i + pagine.length) % pagine.length;
      pagine.forEach((p, k) => {
        p.hidden = k !== attuale;
        if (k === attuale) {
          p.classList.remove('gira');
          void p.offsetWidth; // riavvia l'animazione
          p.classList.add('gira');
        }
      });
      tracce.forEach((t, k) => t.setAttribute('aria-current', String(k === attuale)));
      if (aggiornaIndirizzo && root.dataset.hash) history.replaceState(null, '', `#${pagine[attuale].id}`);
    };
    // Cambio pagina chiesto da chi visita: chi usa uno screen reader sente quale insegnante è comparso.
    const vai = (i: number) => {
      mostra(i);
      annuncio.textContent = `${attuale + 1} di ${pagine.length}: ${pagine[attuale].getAttribute('aria-label')}`;
    };
    root.querySelector('[data-prev]')?.addEventListener('click', () => vai(attuale - 1));
    root.querySelector('[data-next]')?.addEventListener('click', () => vai(attuale + 1));
    tracce.forEach((t, k) => t.addEventListener('click', () => vai(k)));
    root.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') vai(attuale - 1);
      if (e.key === 'ArrowRight') vai(attuale + 1);
    });
    // Arrivando da un link tipo /insegnanti/#canto si apre la pagina giusta.
    const daHash = pagine.findIndex((p) => `#${p.id}` === location.hash);
    if (daHash > 0) mostra(daHash, false);
  });
</script>

<style>
  /* Il libretto ha una grafica sua, da CD: i caratteri a macchina (IBM Plex Mono)
     usano la misura delle etichette, il nome e la tracklist hanno misure proprie. */
  .lettore { padding-bottom: 40px; }
  .comandi { display: flex; justify-content: space-between; align-items: center; gap: 16px; margin-bottom: 24px; max-width: 960px; margin-left: auto; margin-right: auto; }
  .tasti { display: flex; gap: 8px; }
  .tasto { width: 48px; height: 48px; border-radius: 50%; border: 2px solid var(--line-strong); background: transparent; color: #fff; display: grid; place-items: center; cursor: pointer; transition: background 0.2s, transform 0.2s; }
  .tasto:hover { background: var(--red); transform: scale(1.06); }

  .palco { position: relative; max-width: 960px; margin: 0 auto; }
  .disco {
    position: absolute; right: -150px; top: 4%; width: 46%; aspect-ratio: 1; border-radius: 50%;
    background: conic-gradient(from 20deg, #cfd2d6, #f4f4f2, #a9aeb5, #e9e4dc, #c9cdd3, #f6f2ea, #b4b8be, #cfd2d6);
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.5);
    animation: gira-disco 14s linear infinite;
  }
  .solchi { position: absolute; inset: 4%; border-radius: 50%; background: repeating-radial-gradient(circle, rgba(255, 255, 255, 0) 0 3px, rgba(20, 13, 15, 0.05) 3px 4px); }
  .etichetta { position: absolute; inset: 27%; border-radius: 50%; background: var(--red); display: grid; place-items: center; }
  .etichetta img { width: 62%; height: 62%; border-radius: 50%; object-fit: cover; }
  .foro { position: absolute; inset: 46.5%; border-radius: 50%; background: var(--ink); }
  @keyframes gira-disco { to { transform: rotate(360deg); } }

  .libretto { position: relative; display: grid; grid-template-columns: 1fr 1fr; box-shadow: 0 30px 70px rgba(0, 0, 0, 0.6); }
  .libretto.gira { animation: sfoglia 0.5s cubic-bezier(0.2, 0.7, 0.2, 1) both; transform-origin: left center; }
  @keyframes sfoglia { from { opacity: 0; transform: perspective(1400px) rotateY(-14deg); } to { opacity: 1; transform: none; } }

  .foto { position: relative; aspect-ratio: 1; overflow: hidden; background: var(--card); }
  .foto img { width: 100%; height: 100%; object-fit: cover; object-position: center 25%; filter: contrast(1.05) saturate(0.92); }
  .foto::after { content: ''; position: absolute; inset: 0; background: linear-gradient(to right, rgba(0, 0, 0, 0) 80%, rgba(0, 0, 0, 0.35)); pointer-events: none; }
  .senza-foto { position: absolute; inset: 0; background: var(--red); display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 8px; }
  .senza-foto .grande { font-family: var(--display); font-size: clamp(6.25rem, 16vw, 10rem); line-height: 0.8; color: rgba(255, 255, 255, 0.18); }
  .senza-foto .script { font-size: var(--titolo-5); color: var(--cream); }
  .track { position: absolute; left: 16px; bottom: 16px; z-index: 1; font-family: 'IBM Plex Mono', monospace; font-size: var(--testo-xs); letter-spacing: 0.12em; text-transform: uppercase; background: rgba(20, 13, 15, 0.6); padding: 4px 8px; }

  .note {
    position: relative; aspect-ratio: 1; padding: clamp(24px, 4vw, 40px) clamp(24px, 4vw, 40px) 32px; color: var(--ink);
    background-color: #f3ebdd; background-image: radial-gradient(rgba(20, 13, 15, 0.05) 1px, transparent 1px); background-size: 5px 5px;
    display: flex; flex-direction: column; gap: 12px;
  }
  .note::before { content: ''; position: absolute; left: 0; top: 0; bottom: 0; width: 24px; background: linear-gradient(to right, rgba(0, 0, 0, 0.18), rgba(0, 0, 0, 0)); }
  .note-top { display: flex; justify-content: space-between; gap: 12px; font-family: 'IBM Plex Mono', monospace; font-size: var(--testo-xs); letter-spacing: 0.1em; text-transform: uppercase; color: var(--red-dark); }
  .note-nome { margin-top: 8px; font-size: clamp(2.75rem, 6vw, 4rem); line-height: 0.88; overflow-wrap: anywhere; }
  .ruolo { font-size: var(--titolo-5); color: var(--red); margin-top: -4px; }
  .bio :global(p) { margin: 0; font-size: var(--testo-m); line-height: 1.6; color: var(--on-cream); }
  .crediti { margin: auto 0 0; display: grid; grid-template-columns: 88px 1fr; gap: 8px 12px; font-family: 'IBM Plex Mono', monospace; font-size: var(--testo-xs); line-height: 1.45; border-top: 1px solid rgba(20, 13, 15, 0.25); padding-top: 12px; }
  .crediti dt { color: var(--red-dark); text-transform: uppercase; letter-spacing: 0.08em; }
  .crediti dd { margin: 0; }
  .pagina { position: absolute; right: 16px; bottom: 8px; font-family: 'IBM Plex Mono', monospace; font-size: var(--testo-xs); color: rgba(20, 13, 15, 0.65); }

  .tracklist { max-width: 960px; margin: 56px auto 0; }
  .tl-head { display: flex; justify-content: space-between; border-bottom: 1px solid var(--line); padding-bottom: 8px; margin-bottom: 8px; font-family: 'IBM Plex Mono', monospace; font-size: var(--testo-xs); letter-spacing: 0.14em; text-transform: uppercase; color: var(--muted); }
  .tracklist ol { margin: 0; padding: 0; list-style: none; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(380px, 100%), 1fr)); column-gap: 32px; }
  .tracklist button { display: flex; align-items: center; gap: 12px; width: 100%; min-height: 48px; padding: 8px 12px; border: none; border-bottom: 1px solid #2a1e21; background: transparent; color: #fff; font: inherit; cursor: pointer; text-align: left; transition: background 0.2s; }
  .tracklist button:hover { background: var(--card-hover); }
  .tracklist button[aria-current='true'] { background: var(--red); }
  .tl-n { font-family: 'IBM Plex Mono', monospace; font-size: var(--testo-xs); color: var(--red-light); width: 32px; }
  .tracklist button[aria-current='true'] .tl-n { color: var(--cream); }
  .tl-nome { font-family: var(--display); font-size: 1.5rem; text-transform: uppercase; flex-grow: 1; }
  .tl-str { font-family: 'IBM Plex Mono', monospace; font-size: var(--testo-xs); color: var(--muted); }
  .tracklist button[aria-current='true'] .tl-str { color: var(--cream); }

  /* Contrasto elevato di Windows: la traccia scelta viene sottolineata */
  @media (forced-colors: active) {
    .tracklist button[aria-current='true'] .tl-nome { text-decoration: underline 2px; text-underline-offset: 4px; }
  }

  /* Tablet e telefono: le due pagine una sopra l'altra, il disco sparisce */
  @media (max-width: 860px) {
    .disco { display: none; }
    .libretto { grid-template-columns: 1fr; }
    .note { aspect-ratio: auto; min-height: 380px; }
  }
</style>
