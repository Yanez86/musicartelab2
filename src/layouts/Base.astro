---
// Font ospitati sul sito (niente richieste a Google Fonts dai visitatori).
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
import '@fontsource/inter/400.css';
import '@fontsource/inter/500.css';
import '@fontsource/inter/600.css';
import '@fontsource/inter/700.css';
import '@fontsource/kaushan-script/400.css';
import '@fontsource/passion-one/400.css';
import '@fontsource/passion-one/700.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { sito } from '../data/sito';
import { u } from '../lib/url';

interface Props {
  title?: string;
  description?: string;
  image?: string; // immagine per l'anteprima dei link, es. 'img/eventi/locandina.jpg'
  current?: string;
  overlayHeader?: boolean;
}
const {
  title,
  description = `Scuola di musica pop e rock a ${sito.citta}: corsi di canto, chitarra, basso, batteria, pianoforte e coro per bambini, ragazzi e adulti, concerti ed eventi dal vivo.`,
  image = 'img/splash.jpg',
  current = '',
  overlayHeader = false,
} = Astro.props;
const fullTitle = title ? `${title} · ${sito.nome}` : `${sito.nome} · ${sito.sottotitolo} a ${sito.citta}`;
// Indirizzo ufficiale della pagina, per i motori di ricerca e le anteprime dei link
// (sempre con la barra finale, come nella mappa del sito).
const canonical = new URL(Astro.url.pathname.replace(/\/?$/, '/'), Astro.site);
---
<!doctype html>
<html lang="it">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" href={u('sitemap-index.xml')} />
    {sito.googleVerifica && <meta name="google-site-verification" content={sito.googleVerifica} />}
    <link rel="icon" href={u('img/logo.jpg')} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={`${sito.nome} ${sito.forma}`} />
    <meta property="og:locale" content="it_IT" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(u(image), Astro.site)} />
    <meta name="twitter:card" content="summary_large_image" />
    <slot name="head" />
  </head>
  <body>
    <Header current={current} overlay={overlayHeader} />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
