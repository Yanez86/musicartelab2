---
// Font ospitati sul sito (niente richieste a Google Fonts dai visitatori).
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
import '@fontsource/inter/400.css';
import '@fontsource/inter/500.css';
import '@fontsource/inter/600.css';
import '@fontsource/inter/700.css';
import '@fontsource/kaushan-script/400.css';
import '@fontsource/passion-one/400.css';
import '@fontsource/passion-one/700.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { sito } from '../data/sito';
import { u } from '../lib/url';

interface Props {
  title?: string;
  description?: string;
  current?: string;
  overlayHeader?: boolean;
}
const {
  title,
  description = `${sito.nome} ${sito.forma}: corsi ed eventi di musica pop e rock a ${sito.citta}.`,
  current = '',
  overlayHeader = false,
} = Astro.props;
const fullTitle = title ? `${title} · ${sito.nome}` : `${sito.nome} · ${sito.sottotitolo} a ${sito.citta}`;
---
<!doctype html>
<html lang="it">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="icon" href={u('img/logo.jpg')} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(u('img/splash.jpg'), Astro.site)} />
  </head>
  <body>
    <Header current={current} overlay={overlayHeader} />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
